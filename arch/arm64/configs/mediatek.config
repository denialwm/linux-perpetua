# SPDX-License-Identifier: GPL-2.0
#
# MediaTek phones and tablets: the drivers that defconfig builds for every
# MediaTek SoC, with the shared ones these devices need early built in.

# Platform
CONFIG_ARCH_MEDIATEK=y

# Storage, USB and the watchdog the bootloader leaves running
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_USB_MTU3=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
