# SPDX-License-Identifier: GPL-2.0
#
# MediaTek MT6897 (Dimensity 8300)
CONFIG_NR_CPUS=8

# USB PHY, built in for the USB gadget at boot
CONFIG_PHY_MTK_XSPHY=y

# Display
CONFIG_DRM_MEDIATEK_DPU=m

# The main PMIC on SPMI and the keys: power and volume up on the PMIC,
# volume down on the keypad
CONFIG_MFD_MTK_SPMI_PMIC=m
CONFIG_KEYBOARD_MT6779=m

# The connectivity subsystem, its rails on the two PMICs, and its Wi-Fi
# core, an MT7921 that the bootloader loads the firmware of
CONFIG_REGULATOR_MT6363=m
CONFIG_REGULATOR_MT6368=m
CONFIG_MTK_CONSYS=m
CONFIG_MT7921E=m
CONFIG_MT7921_SOC=y
