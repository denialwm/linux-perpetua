# SPDX-License-Identifier: GPL-2.0
#
# MediaTek MT6897 (Dimensity 8300)
CONFIG_NR_CPUS=8

# USB PHY, built in for the USB gadget at boot
CONFIG_PHY_MTK_XSPHY=y

# Display
CONFIG_DRM_MEDIATEK_DPU=m

# The main PMIC on SPMI and the keys: power and volume up on the PMIC,
# volume down on the keypad
CONFIG_MFD_MTK_SPMI_PMIC=m
CONFIG_KEYBOARD_MT6779=m
