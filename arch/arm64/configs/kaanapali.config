#
# Qualcomm Kaanapali (SM8850, Snapdragon 8 Elite Gen 5)
CONFIG_NR_CPUS=8

# Multimedia clock controllers, built in for the display and GPU at boot
CONFIG_CLK_KAANAPALI_CAMCC=y
CONFIG_CLK_KAANAPALI_DISPCC=y
CONFIG_CLK_KAANAPALI_GPUCC=y
CONFIG_CLK_KAANAPALI_TCSRCC=y
CONFIG_CLK_KAANAPALI_VIDEOCC=y
