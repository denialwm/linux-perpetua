# SPDX-License-Identifier: GPL-2.0
#
# Qualcomm SM8475 (Cape, Snapdragon 8+ Gen 1)
CONFIG_NR_CPUS=8

# Display and GPU clock controllers, built in for the display and GPU at boot
CONFIG_SM_DISPCC_8450=y
CONFIG_SM_GPUCC_8450=y

# Pin controller, built in: everything probes behind it
CONFIG_PINCTRL_SM8475=y

# USB 2.0 PHY and its repeater, built in for the USB gadget at boot
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_NXP_PTN3222=y
