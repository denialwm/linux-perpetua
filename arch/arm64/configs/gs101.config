# SPDX-License-Identifier: GPL-2.0
#
# Google Tensor gs101
CONFIG_NR_CPUS=8
# The PMICs sit behind ACPM. Their regulators supply the bootloader's
# framebuffer and the RTC, which the boot userspace needs before the root
# filesystem.
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_MFD_SEC_ACPM=y
# The CPU clocks are ACPM's; cpufreq and the CPU cooling devices of the
# thermal zones need them from boot.
CONFIG_EXYNOS_ACPM_CLK=y
# The display pipeline: DECON, DPP and the DSI host, in exynosdrm. Built
# in: the rescue loads no modules, and the takeover replaces
# simple-framebuffer from boot.
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_GS101=y
# The PCIe controllers and their PHYs; HSI2's carries the Wi-Fi chip.
CONFIG_PCIE_GS101=y
CONFIG_PHY_GS101_PCIE=y
# The Wi-Fi chip, on HSI2's PCIe link (brcmfmac itself is in defconfig).
CONFIG_BRCMFMAC_PCIE=y
