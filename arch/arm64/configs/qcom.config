# SPDX-License-Identifier: GPL-2.0
#
# Qualcomm phones and tablets: the drivers that defconfig builds for every
# Qualcomm SoC, with the shared ones these devices need early built in.

# Platform
CONFIG_ARCH_QCOM=y

# SoC infrastructure
CONFIG_REGULATOR_ARM_SCMI=y
CONFIG_QCOMTEE=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_CPUCP_MBOX=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SLIMBUS=y

# PMICs, USB and Type-C
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE_8996=m

# Display and sound
CONFIG_DRM_MSM=y
CONFIG_SND_SOC_WCD938X_SDW=m

# Wi-Fi debugging
CONFIG_ATH11K_DEBUG=y
CONFIG_ATH12K_DEBUG=y
CONFIG_ATH12K_DEBUGFS=y

# Hardware that Qualcomm phones and tablets do not have
# CONFIG_AQUANTIA_PHY is not set
