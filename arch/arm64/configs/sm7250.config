# SPDX-License-Identifier: GPL-2.0
#
# Qualcomm SM7250 (Lito)
CONFIG_NR_CPUS=8

# Clocks, pinctrl and interconnect, built in for the UART before the rootfs.
CONFIG_SM_GCC_7250=y
CONFIG_PINCTRL_SM7250=y
CONFIG_INTERCONNECT_QCOM_SM7250=y

# Storage and USB, for the root filesystem and the rescue link.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# Take over the watchdog the Android bootloader leaves running.
CONFIG_QCOM_WDT=y
