# SPDX-License-Identifier: GPL-2.0
# Qualcomm SM7225 (Snapdragon 750G): clocks and pinctrl needed before the rootfs.
CONFIG_NR_CPUS=8
CONFIG_SM_GCC_6350=y
CONFIG_PINCTRL_SM6350=y
CONFIG_INTERCONNECT_QCOM_SM6350=y
CONFIG_PHY_QCOM_QUSB2=y

# Take over the watchdog left running by the Android bootloader.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
