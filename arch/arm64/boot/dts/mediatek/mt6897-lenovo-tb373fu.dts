/*
 * Lenovo Idea Tab Pro (TB373FU)
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include "mt6897.dtsi"

/ {
	model = "Lenovo Idea Tab Pro";
	compatible = "lenovo,tb373fu", "mediatek,mt6897";
	chassis-type = "tablet";

	/* Two chips drive the panel's LED strings; one brightness for both. */
	backlight: backlight {
		compatible = "led-backlight";
		leds = <&backlight_led0>, <&backlight_led1>;
		default-brightness-level = <512>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bootargs = "console=tty0 fbcon=font:TER16x32 root=PARTUUID=0000004f-39c2-4488-9bb0-00cb43c9ccd4 rootfstype=ext4 rootwait rw init=/usr/lib/systemd/systemd panic=10 arm64.nomte clk_ignore_unused pd_ignore_unused";

		fdt-handoff {
			stock-compatible = "mediatek,MT6897";
			stock-model = "MT8792";
			/* Lenovo's bootloader passes this word on every boot. */
			stock-bootargs = "lenovoraw_backup_size=0";
		};

		/* The bootloader's splash buffer; the panel runs in video mode. */
		framebuffer0: framebuffer@fc16f000 {
			compatible = "simple-framebuffer";
			reg = <0 0xfc16f000 0 (2944 * 1840 * 4)>;
			width = <2944>;
			height = <1840>;
			stride = <(2944 * 4)>;
			format = "a8r8g8b8";
		};
	};

	panel_vddi: regulator-panel-vddi {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pio 63 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/* 8 GiB; the bootloader passes what is usable. */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0x2 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The bootloader allocates its MET buffer here on every boot and
		 * leaves it alone across a warm reset, unlike its own ramoops
		 * region, which it overwrites from expdb.
		 */
		ramoops@9f17f000 {
			compatible = "ramoops";
			reg = <0 0x9f17f000 0 0x100000>;
			no-map;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
		};

		framebuffer@fc16f000 {
			reg = <0 0xfc16f000 0 0x3e90000>;
			no-map;
		};

		/* Scanout buffers: the display reads physical memory. */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0 0x10000000>;
			linux,cma-default;
		};
	};
};

&dpu {
	status = "okay";

	panel@0 {
		compatible = "lenovo,tb373fu-tianma-nt36532", "novatek,nt36532";
		reg = <0>;
		reset-gpios = <&pio 41 GPIO_ACTIVE_LOW>;
		vddi-supply = <&panel_vddi>;
		avdd-supply = <&panel_avdd>;
		avee-supply = <&panel_avee>;
		backlight = <&backlight>;
	};
};

&i2c3 {
	status = "okay";

	led-controller@36 {
		compatible = "sgmicro,sgm37604a";
		reg = <0x36>;

		backlight_led1: led {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_BACKLIGHT;
		};
	};
};

&i2c7 {
	clock-frequency = <400000>;
	status = "okay";

	fuel-gauge@55 {
		compatible = "mitsumi,mm8013";
		reg = <0x55>;
	};
};

&i2c13 {
	status = "okay";

	led-controller@36 {
		compatible = "sgmicro,sgm37604a";
		reg = <0x36>;

		backlight_led0: led {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_BACKLIGHT;
		};
	};

	/* The panel's bias supplies. */
	regulator@3e {
		compatible = "siliconmitus,sm5109", "ti,tps65132";
		reg = <0x3e>;

		panel_avdd: outp {
			regulator-name = "panel_avdd";
			regulator-min-microvolt = <5800000>;
			regulator-max-microvolt = <5800000>;
			enable-gpios = <&pio 187 GPIO_ACTIVE_HIGH>;
			regulator-boot-on;
		};

		panel_avee: outn {
			regulator-name = "panel_avee";
			regulator-min-microvolt = <5800000>;
			regulator-max-microvolt = <5800000>;
			enable-gpios = <&pio 186 GPIO_ACTIVE_HIGH>;
			regulator-boot-on;
		};
	};
};

/* The panel's lanes run with the drive and de-emphasis of the stock setup. */
&mipi_tx0 {
	drive-strength-microamp = <5200>;
	mediatek,de-emphasis;
	status = "okay";
};

&mipi_tx1 {
	drive-strength-microamp = <5200>;
	mediatek,de-emphasis;
	status = "okay";
};

&ssusb {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	mediatek,force-vbus;
	status = "okay";
};

&ufshci {
	status = "okay";
};

&xsphy {
	status = "okay";
};
