/dts-v1/;

#include <dt-bindings/regulator/samsung,s2mpg10-regulator.h>
#include "gs101-pixel-common.dtsi"

/ {
	model = "Oriole";
	compatible = "google,gs101-oriole", "google,gs101";

	chosen {
		/*
		 * A panic reboots, so an unattended phone comes back. bootconfig:
		 * the bootloader's androidboot properties, the slot among them.
		 */
		bootargs = "rdinit=/init panic=10 loglevel=7 log_buf_len=2M bootconfig";

		/*
		 * The bootloader rewrites the root compatible of the vendor_boot
		 * tree and takes the model from the dtbo entry of the board, the
		 * newest Oriole one on retail phones. It passes the vendor_boot
		 * ramdisks followed by the boot one, which carries the boot
		 * userspace.
		 */
		fdt-handoff {
			stock-compatible = "google,GS101 Oriole";
			stock-model = "Oriole DVT";
			keep-initrd;
		};
	};

	/* 8 GiB; the bootloader passes what is usable. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>,
		      <0x8 0x80000000 0x80000000>,
		      <0x9 0x00000000 0x80000000>,
		      <0x9 0x80000000 0x80000000>;
	};
};

&acpm_ipc {
	pmic-1 {
		regulators {
			ldo14m {
				/* PLL */
				regulator-name = "avdd18_tcxo";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
				samsung,ext-control = <S2MPG10_EXTCTRL_TCXO_ON>;
			};

			ldo31m {
				regulator-name = "nfc";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};
		};
	};
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;

	status = "okay";
};

&framebuffer0 {
	width = <1080>;
	height = <2400>;
	stride = <(1080 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

&hsi2c_12 {
	usb-typec@25 {
		connector {
			/*
			 * The bootloader runs with its serial console off
			 * (androidboot.serialconsole = "0"): there is no
			 * console on the port for USB PD to disturb.
			 */
			/delete-property/ pd-disable;
			/delete-property/ typec-power-opmode;
		};
	};
};

