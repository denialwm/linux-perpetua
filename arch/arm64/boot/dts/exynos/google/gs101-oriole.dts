/dts-v1/;

#include <dt-bindings/regulator/samsung,s2mpg10-regulator.h>
#include "gs101-pixel-common.dtsi"

/ {
	model = "Oriole";
	compatible = "google,gs101-oriole", "google,gs101";

	chosen {
		/*
		 * A panic reboots, so an unattended phone comes back. bootconfig:
		 * the bootloader's androidboot properties, the slot among them.
		 * console=tty0: the bootloader leaves the UART of stdout-path
		 * unconfigured and passes console=null, which these arguments
		 * replace; as a console at its 9600 baud default, the UART held
		 * the boot for the replay of the log.
		 */
		bootargs = "rdinit=/init panic=10 loglevel=7 log_buf_len=2M bootconfig console=tty0";

		/*
		 * The bootloader rewrites the root compatible of the vendor_boot
		 * tree and takes the model from the dtbo entry of the board, the
		 * newest Oriole one on retail phones. It passes the vendor_boot
		 * ramdisks followed by the boot one, which carries the boot
		 * userspace.
		 */
		fdt-handoff {
			stock-compatible = "google,GS101 Oriole";
			stock-model = "Oriole DVT";
			keep-initrd;
		};
	};

	/* 8 GiB; the bootloader passes what is usable. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>,
		      <0x8 0x80000000 0x80000000>,
		      <0x9 0x00000000 0x80000000>,
		      <0x9 0x80000000 0x80000000>;
	};
};

&acpm_ipc {
	pmic-1 {
		regulators {
			ldo14m {
				/* PLL */
				regulator-name = "avdd18_tcxo";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
				samsung,ext-control = <S2MPG10_EXTCTRL_TCXO_ON>;
			};

			s2mpg10_ldo25m: ldo25m {
			};

			s2mpg10_ldo26m: ldo26m {
			};

			s2mpg10_ldo31m: ldo31m {
				/*
				 * Also the panel's VDDI (L31M_DISP_VDDI). The
				 * bootloader leaves the panel running from it,
				 * and nothing brings the panel back up once it
				 * goes off.
				 */
				regulator-name = "nfc";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};
		};
	};
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;

	status = "okay";
};

&decon0 {
	status = "okay";
};

&dpp0 {
	status = "okay";
};

&dsim0 {
	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3fc3";
		reg = <0>;
		reset-gpios = <&gpp24 1 GPIO_ACTIVE_LOW>;
		vci-supply = <&s2mpg10_ldo22m>;
		vddi-supply = <&s2mpg10_ldo31m>;
	};
};

&framebuffer0 {
	width = <1080>;
	height = <2400>;
	stride = <(1080 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

&hsi2c_12 {
	usb-typec@25 {
		connector {
			/*
			 * The bootloader runs with its serial console off
			 * (androidboot.serialconsole = "0"): there is no
			 * console on the port for USB PD to disturb.
			 */
			/delete-property/ pd-disable;
			/delete-property/ typec-power-opmode;
		};
	};
};

&pinctrl_gpio_alive {
	ts_irq: ts-irq-pins {
		samsung,pins = "gpa9-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	ts_reset: ts-reset-pins {
		samsung,pins = "gpp26-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&spi_11 {
	cs-gpios = <&gpp23 3 GPIO_ACTIVE_LOW>;

	status = "okay";

	touchscreen@0 {
		compatible = "st,stmfts5";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupts-extended = <&gpa9 0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&ts_irq>, <&ts_reset>;
		pinctrl-names = "default";
		reset-gpios = <&gpp26 0 GPIO_ACTIVE_LOW>;
		vdd-supply = <&s2mpg10_ldo25m>;
		avdd-supply = <&s2mpg10_ldo26m>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;

		controller-data {
			samsung,spi-feedback-delay = <1>;
		};
	};
};

&usi11 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};
