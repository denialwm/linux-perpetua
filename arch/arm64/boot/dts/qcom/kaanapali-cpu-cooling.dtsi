// SPDX-License-Identifier: BSD-3-Clause
/*
 * CPU passive cooling for every kaanapali board.
 *
 * The SoC thermal zones only carry hot and critical trips at 120 and
 * 125 °C, and the SCMI cpufreq firmware does not hold the cores below
 * them: a fan-cooled board ran its prime cores at full clock past 105 °C.
 * Throttle each cluster from any of its CPU, LLC and QMX sensors at
 * KAANAPALI_CPU_PASSIVE_MC with 5 °C of hysteresis, polling those zones
 * every 250 ms while passive.
 *
 * There is no default: every board defines KAANAPALI_CPU_PASSIVE_MC, in
 * millidegrees, before it includes kaanapali.dtsi, with a value tuned on
 * that hardware, and says in a comment where the value came from. One zone
 * can be tuned further by overriding its trip label.
 *
 * To find the value for a new board, ask its developer, or start from the
 * stock Android configuration: the trips of the cpu-*, cpullc-* and qmx-*
 * zones in the stock device tree (usually a thermal HAL trip and
 * emergency core pauses well above 100 °C), and the vendor's
 * /vendor/etc/thermal-engine.conf or thermal HAL configuration, which
 * often throttle on skin sensors instead. Then confirm the value with a
 * load test on the device.
 */

#ifndef KAANAPALI_CPU_PASSIVE_MC
#error "KAANAPALI_CPU_PASSIVE_MC is not set: this board has no tuned CPU throttle temperature. Ask the device's developer for the value, or derive it from the stock Android trip points (cpu-*, cpullc-*, qmx-* thermal zones in the stock device tree, /vendor/etc/thermal-engine.conf or the thermal HAL config), then add '#define KAANAPALI_CPU_PASSIVE_MC <millidegrees>', with a comment on its source, above the board file's include of kaanapali.dtsi. See kaanapali-cpu-cooling.dtsi."
#endif

#define CPU_PASSIVE(LABEL, CLUSTER)					\
	polling-delay-passive = <250>;					\
	trips {								\
		LABEL: passive {					\
			temperature = <KAANAPALI_CPU_PASSIVE_MC>;	\
			hysteresis = <5000>;				\
			type = "passive";				\
		};							\
	};								\
	cooling-maps {							\
		cpu-map {						\
			trip = <&LABEL>;				\
			cooling-device = <CLUSTER THERMAL_NO_LIMIT THERMAL_NO_LIMIT>; \
		};							\
	};

&{/thermal-zones/cpullc-0-0-thermal} { CPU_PASSIVE(cpullc_0_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpullc-0-1-thermal} { CPU_PASSIVE(cpullc_0_1_thermal_passive, &cpu0) };
&{/thermal-zones/qmx-0-0-thermal} { CPU_PASSIVE(qmx_0_0_thermal_passive, &cpu0) };
&{/thermal-zones/qmx-0-1-thermal} { CPU_PASSIVE(qmx_0_1_thermal_passive, &cpu0) };
&{/thermal-zones/qmx-0-2-thermal} { CPU_PASSIVE(qmx_0_2_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-0-0-thermal} { CPU_PASSIVE(cpu_0_0_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-0-1-thermal} { CPU_PASSIVE(cpu_0_0_1_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-1-0-thermal} { CPU_PASSIVE(cpu_0_1_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-1-1-thermal} { CPU_PASSIVE(cpu_0_1_1_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-2-0-thermal} { CPU_PASSIVE(cpu_0_2_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-2-1-thermal} { CPU_PASSIVE(cpu_0_2_1_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-3-0-thermal} { CPU_PASSIVE(cpu_0_3_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-3-1-thermal} { CPU_PASSIVE(cpu_0_3_1_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-4-0-thermal} { CPU_PASSIVE(cpu_0_4_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-4-1-thermal} { CPU_PASSIVE(cpu_0_4_1_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-5-0-thermal} { CPU_PASSIVE(cpu_0_5_0_thermal_passive, &cpu0) };
&{/thermal-zones/cpu-0-5-1-thermal} { CPU_PASSIVE(cpu_0_5_1_thermal_passive, &cpu0) };

&{/thermal-zones/cpullc-1-0-thermal} { CPU_PASSIVE(cpullc_1_0_thermal_passive, &cpu6) };
&{/thermal-zones/cpullc-1-1-thermal} { CPU_PASSIVE(cpullc_1_1_thermal_passive, &cpu6) };
&{/thermal-zones/qmx-1-0-thermal} { CPU_PASSIVE(qmx_1_0_thermal_passive, &cpu6) };
&{/thermal-zones/qmx-1-1-thermal} { CPU_PASSIVE(qmx_1_1_thermal_passive, &cpu6) };
&{/thermal-zones/qmx-1-2-thermal} { CPU_PASSIVE(qmx_1_2_thermal_passive, &cpu6) };
&{/thermal-zones/qmx-1-3-thermal} { CPU_PASSIVE(qmx_1_3_thermal_passive, &cpu6) };
&{/thermal-zones/qmx-1-4-thermal} { CPU_PASSIVE(qmx_1_4_thermal_passive, &cpu6) };
&{/thermal-zones/cpu-1-0-0-thermal} { CPU_PASSIVE(cpu_1_0_0_thermal_passive, &cpu6) };
&{/thermal-zones/cpu-1-0-1-thermal} { CPU_PASSIVE(cpu_1_0_1_thermal_passive, &cpu6) };
&{/thermal-zones/cpu-1-1-0-thermal} { CPU_PASSIVE(cpu_1_1_0_thermal_passive, &cpu6) };
&{/thermal-zones/cpu-1-1-1-thermal} { CPU_PASSIVE(cpu_1_1_1_thermal_passive, &cpu6) };

#undef CPU_PASSIVE
