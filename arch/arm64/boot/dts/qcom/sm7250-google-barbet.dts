/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm7250.dtsi"

/* PM7250B is configured to use SID2/3 */
#define PM7250B_SID 2
#define PM7250B_SID1 3

#include "pm8150.dtsi"
#include "pm8150l.dtsi"
#include "pm7250b.dtsi"

/ {
	model = "Google Pixel 5a";
	compatible = "google,barbet", "qcom,sm7250";

	aliases {
		serial0 = &debug_uart;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The bootloader command line is replaced by this one. Name the
		 * console, keep the bootloader's initramfs and take the kernel out
		 * of the clock and power-domain cleanup that its own nodes would
		 * otherwise trigger.
		 */
		bootargs = "earlycon=qcom_geni,0x888000 keep_bootcon console=ttyMSM0,115200n8 loglevel=7 rdinit=/init panic=15 bootconfig";
		stdout-path = "serial0:115200n8";

		/*
		 * The bootloader boots Google's own Barbet tree. Its root model
		 * names the board, so the handoff can tell it apart from other
		 * SM7250 devices.
		 */
		fdt-handoff {
			stock-compatible = "google,barbet-sm7250";
			stock-model = "Google Inc. MSM sm7250 v2 Barbet MP";
			keep-initrd;
		};
	};

	/*
	 * The Pixel bootloader patches /memory (without a unit address), so keep
	 * the stock node shape for it to fill in the real DRAM size.
	 */
	memory {
		device_type = "memory";
		reg = <0 0x80000000 0 0>;
	};

	reserved-memory {
		cont_splash_mem: cont-splash@a0000000 {
			reg = <0 0xa0000000 0 0x2300000>;
			no-map;
		};

		dfps_data_mem: dfps-data@a2300000 {
			reg = <0 0xa2300000 0 0x100000>;
			no-map;
		};

		reserved_pil_mem: reserved-pil@8bc17400 {
			reg = <0 0x8bc17400 0 0x3e8c00>;
			no-map;
		};
	};
};

/* Barbet's firmware carveouts differ from the generic SM7250 memory map. */
&ipa_gsi_mem {
	reg = <0 0x8bc10000 0 0x5400>;
};

/delete-node/ &gpu_mem;

&reserved_memory {
	gpu_mem: gpu@8bc15400 {
		reg = <0 0x8bc15400 0 0x2000>;
		no-map;
	};
};

&modem_wlan_mem {
	reg = <0 0x8c000000 0 0x11800000>;
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8150-rpmh-regulators";
		qcom,pmic-id = "a";

		vreg_s4a_1p8: smps4 {
			regulator-name = "vreg_s4a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l2a_3p1: ldo2 {
			regulator-name = "vreg_l2a_3p1";
			regulator-min-microvolt = <3072000>;
			regulator-max-microvolt = <3072000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l5a_0p88: ldo5 {
			regulator-name = "vreg_l5a_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l9a_1p2: ldo9 {
			regulator-name = "vreg_l9a_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l12a_1p8: ldo12 {
			regulator-name = "vreg_l12a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l13a_3p3: ldo13 {
			regulator-name = "vreg_l13a_3p3";
			regulator-min-microvolt = <3304000>;
			regulator-max-microvolt = <3304000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l16a_3p0: ldo16 {
			regulator-name = "vreg_l16a_3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8150l-rpmh-regulators";
		qcom,pmic-id = "c";

		vreg_l7c_2p95: ldo7 {
			regulator-name = "vreg_l7c_2p95";
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};

		vreg_l1c_1p8: ldo1 {
			regulator-name = "vreg_l1c_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
			regulator-always-on;
		};
	};
};

&ufs_mem_hc {
	vcc-supply = <&vreg_l7c_2p95>;
	vcc-max-microamp = <800000>;
	vccq2-supply = <&vreg_s4a_1p8>;
	vccq2-max-microamp = <800000>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l5a_0p88>;
	vdda-pll-supply = <&vreg_l9a_1p2>;
	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

&usb_1_hsphy {
	vdda-pll-supply = <&vreg_l5a_0p88>;
	vdda18-supply = <&vreg_l12a_1p8>;
	vdda33-supply = <&vreg_l2a_3p1>;
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";

	debug_uart: serial@888000 {
		compatible = "qcom,geni-debug-uart";
		reg = <0 0x888000 0 0x4000>;
		clock-names = "se";
		clocks = <&gcc GCC_QUPV3_WRAP0_S2_CLK>;
		interrupts = <GIC_SPI 603 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&qup_uart2_default>;
		status = "okay";
	};
};

&tlmm {
	/* Secure-world peripherals: do not read their pin configuration. */
	gpio-reserved-ranges = <0 4>, <59 4>;

	qup_uart2_default: qup-uart2-default-state {
		pins = "gpio36", "gpio37";
		function = "qup02";
		drive-strength = <2>;
		bias-disable;
	};

	touch_spi_default: qupv3-se0-spi-default {
		pins = "gpio42", "gpio43", "gpio44", "gpio45";
		function = "qup00";
		drive-strength = <6>;
		bias-disable;
	};

	touch_spi_sleep: qupv3-se0-spi-sleep {
		pins = "gpio42", "gpio43", "gpio44", "gpio45";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_irq_default: ts-irq-default {
		pins = "gpio9";
		function = "gpio";
		bias-pull-up;
		input-enable;
	};

	ts_reset_default: ts-reset-default {
		pins = "gpio8";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

};

/* Display: SM7250 MDSS/DPU with the Barbet Samsung SOFEF01 panel. */
&mdss { status = "okay"; };
&mdss_mdp { status = "okay"; };
&dispcc { status = "okay"; };

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l5a_0p88>;
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l5a_0p88>;
	status = "okay";

	panel@0 {
		compatible = "samsung,sofef01";
		reg = <0>;
		vddio-supply = <&vreg_l1c_1p8>;
		vci-supply = <&vreg_l16a_3p0>;
		poc-supply = <&vreg_l16a_3p0>;
		reset-gpios = <&pm8150l_gpios 8 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint { remote-endpoint = <&mdss_dsi0_out>; };
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&gpu {
	status = "okay";

	zap-shader { firmware-name = "qcom/a620_zap.mdt"; };
};

&gmu { status = "okay"; };

&qupv3_id_0 {
	status = "okay";

	spi0: spi@880000 {
		compatible = "qcom,geni-spi";
		reg = <0 0x880000 0 0x4000>;
		clock-names = "se";
		clocks = <&gcc GCC_QUPV3_WRAP0_S0_CLK>;
		interrupts = <GIC_SPI 601 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		iommus = <&apps_smmu 0x4e3 0x0>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&touch_spi_default>;
		pinctrl-1 = <&touch_spi_sleep>;
		status = "okay";

		touchscreen@0 {
			compatible = "st,fts-spi";
			reg = <0>;
			spi-max-frequency = <10000000>;
			interrupt-parent = <&tlmm>;
			interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
			reset-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;
			ap2lpi-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
			lpi2ap-gpios = <&tlmm 5 GPIO_ACTIVE_HIGH>;
			vdd-supply = <&vreg_l13a_3p3>;
			pinctrl-names = "default";
			pinctrl-0 = <&ts_irq_default>, <&ts_reset_default>;
			touchscreen-size-x = <1080>;
			touchscreen-size-y = <2400>;
			st,max-coords = <1079 2399>;
			st,force-pi-cfg-ver-map = <0x300 0x306>;
			st,save-golden-ms-raw;
			status = "okay";
		};
	};
};

