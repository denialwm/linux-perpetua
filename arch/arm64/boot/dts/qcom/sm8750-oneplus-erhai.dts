// SPDX-License-Identifier: BSD-3-Clause
/*
 * OnePlus Pad 3 (erhai)
 *
 * The rails, tuning values and GPIOs below are the ones the stock
 * bootloader tree of this tablet gives its own kernel. Rails that are not
 * described here keep the state the bootloader left them in; among the
 * display ones, the panel's logic and analog supplies, and its LCD bias,
 * which the backlight controller generates and the bootloader leaves on.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/media/video-interfaces.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/spmi/spmi.h>
#include "sm8750.dtsi"
#include "pm8550.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"

/ {
	model = "OnePlus Pad 3";
	compatible = "oneplus,erhai", "qcom,sm8750";
	chassis-type = "tablet";

	/*
	 * The GENI UART driver numbers its ports from the serial aliases and
	 * fails to probe without any. serial1 as on the other SM8750 boards,
	 * where serial0 is the debug UART.
	 */
	aliases {
		serial1 = &uart14;
		serial2 = &uart8;
	};

	/*
	 * The WCD9395 takes the internal microphones on its analog inputs.
	 * Mic bias 2.7 V, reset and rails as the stock tree gives them.
	 *
	 * The headset is USB-C analog only (no 3.5 mm jack: stock
	 * qcom,msm-mbhc-usbc-audio-supported): the HPH outputs, the headset
	 * mic and the ground reach the connector through the WCD939x USBSS
	 * switch, which reports the audio accessory and the plug
	 * orientation here. The MBHC values are the stock tree's: both
	 * detect switches normally closed (qcom,msm-mbhc-hphl-swh and
	 * -gnd-swh 0), headset/headphone thresholds 2600/112 mV
	 * (qcom,msm-mbhc-hs-mic-max/min-threshold-mv, for the 2.7 V mic
	 * bias), and the board's button thresholds (sun.c def_wcd_mbhc_cal,
	 * OPLUS_ARCH_EXTENDS: hook < 130 mV, vol+ < 253 mV, vol- < 425 mV).
	 */
	wcd939x: audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";

		pinctrl-0 = <&wcd_default>;
		pinctrl-names = "default";

		qcom,hphl-jack-type-normally-closed;
		qcom,ground-jack-type-normally-closed;
		qcom,mbhc-buttons-vthreshold-microvolt = <130000 131000 253000 425000
							  426000 426000 426000 426000>;
		qcom,mbhc-headset-vthreshold-microvolt = <2600000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <112000>;
		qcom,micbias1-microvolt = <2700000>;
		qcom,micbias2-microvolt = <2700000>;
		qcom,micbias3-microvolt = <2700000>;
		qcom,micbias4-microvolt = <2700000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;
		vdd-px-supply = <&vreg_l2i_1p2>;

		#sound-dai-cells = <1>;

		mode-switch;
		orientation-switch;

		port {
			wcd_codec_headset_in: endpoint {
				remote-endpoint = <&wcd_usbss_headset_out>;
			};
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* The init_boot every phone shares carries the boot userspace. */
		bootargs = "rdinit=/init console=tty0 panic=0 loglevel=7 log_buf_len=2M bootconfig";

		/*
		 * The bootloader picks one of the erhai overlays of dtbo, all on
		 * the same SunP base tree; its project id names the tablet.
		 */
		fdt-handoff {
			stock-compatible = "qcom,sun", "qcom,sunp";
			stock-bootargs = "oplusboot.prjname=24924",
					 "oplusboot.prjname=24926",
					 "oplusboot.prjname=24974",
					 "oplusboot.prjname=24976";
			keep-initrd;
		};

		/* Bootloader splash, left running by ABL (XN242, two video-mode links) */
		framebuffer: framebuffer@fc800000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfc800000 0x0 (3392 * 2400 * 4)>;
			width = <3392>;
			height = <2400>;
			stride = <(3392 * 4)>;
			format = "a8r8g8b8";

			/*
			 * Held while no display driver runs, or the boot clean-up
			 * of unused clocks and power domains stops the scanout.
			 */
			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
				 <&dispcc DISP_CC_MDSS_AHB_CLK>,
				 <&dispcc DISP_CC_MDSS_MDP_CLK>,
				 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
				 <&dispcc DISP_CC_MDSS_ESC0_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
				 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
				 <&dispcc DISP_CC_MDSS_ESC1_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
				 <&dispcc DISP_CC_MDSS_PCLK1_CLK>;
			power-domains = <&dispcc MDSS_GDSC>,
					<&dispcc MDSS_INT2_GDSC>;
			/* The level of the fastest MDP clock of mdp_opp_table */
			required-opps = <&rpmhpd_opp_nom_l1>, <&rpmhpd_opp_nom_l1>;
		};
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&key_vol_down_default &lid_default>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <32>;
			linux,can-disable;
			wakeup-source;
		};

		/*
		 * The case's hall sensor (ROHM BU52053NVX, whose ADSP DRI
		 * reads the same line) pulls gpio97 low when the keyboard
		 * case is closed over the tablet. The stock kernel exposes
		 * it as a SW_LID switch, as here.
		 */
		key-lid {
			label = "Lid";
			linux,code = <SW_LID>;
			linux,input-type = <EV_SW>;
			gpios = <&tlmm 97 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			wakeup-source;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";

		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	pmic_glink: pmic-glink {
		compatible = "oneplus,sm8750-pmic-glink",
			     "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		#cooling-cells = <2>;

		/* The plug orientation line, as the stock tree gives it */
		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;

		/*
		 * The ADSP battery-charge-current cap (BATT_CHG_CTRL_LIM),
		 * one entry per cooling state above the firmware max, for
		 * the "qcom-battmgr-charge" cooling device. Stock steps the
		 * cap down 500000 at a time (qcom,thermal-mitigation-step in
		 * the stock fdt) below the per-mode FCC ceiling; that ceiling
		 * is 4400000 in QC/PD mode (the QC/PD rows of
		 * oplus_spec,fccmax-ma-lv/hv in oplus-chg-erhai-common.dtsi)
		 * and 2200000 in VOOC mode. The stock algorithm
		 * (battery_chg_parse_dt in qti_battery_charger.c) yields
		 * seven levels: len = 4400000 / 500000 = 8, then
		 * 4400000 - 8 * 500000 = 0 < 500000, so len = 7, and state N
		 * = 4400000 - N * 500000. In VOOC mode the driver clamps
		 * each state to the firmware max, so the top four states
		 * read 2200000 and the rest 1900000 / 1400000 / 900000.
		 */
		qcom,charge-current-limits-microamp = <3900000 3400000 2900000
						       2400000 1900000 1400000
						       900000>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&wcd_usbss_sbu_mux>;
					};
				};
			};
		};

		/*
		 * The boost the charger firmware drives for the stylus coil.
		 * Stock idles it at 7 V and raises it to 10 V while a stylus
		 * is attached (oplus-chg-erhai-common.dtsi:1868-1869).
		 */
		pen_boost: regulator-pen-boost {
			regulator-name = "pen_boost";
			regulator-min-microvolt = <7000000>;
			regulator-max-microvolt = <10000000>;
		};
	};

	/*
	 * The keyboard cover's supply on the pogo pins, switched by gpio85
	 * (erhai-oplus-pogopin-kb-24924.dtsi:101-123).
	 */
	pogo_vcc: pogo-vcc-regulator {
		compatible = "regulator-fixed";

		regulator-name = "pogo_vcc";
		gpio = <&tlmm 85 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&pogo_vcc_en>;
		pinctrl-names = "default";
	};

	reserved-memory {
		/* The splash the bootloader scans out, splash_region downstream. */
		cont_splash_mem: cont-splash@fc800000 {
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			iommu-addresses = <&mdss 0x0 0xfc800000 0x0 0x2b00000>;
			no-map;
		};

		/*
		 * Where the stock kernel places its dynamic ramoops region, with
		 * its zones: no dmesg records, the console, then pmsg. Recovery
		 * then shows this kernel's console after a warm reset.
		 */
		ramoops@880000000 {
			compatible = "ramoops";
			reg = <0x8 0x80000000 0x0 0x240000>;
			console-size = <0x40000>;
			pmsg-size = <0x200000>;
			no-map;
		};
	};

	/*
	 * The WCN7860 Wi-Fi/Bluetooth combo, on the rails and enable lines
	 * the stock kernel gives it. The Bluetooth enable line is on the
	 * PM8550VE-F GPIO 3; the stock fdt drives it from the vendor
	 * bluetooth driver through the same "bt_uwb_en" pinctrl state.
	 */
	/*
	 * The six AW88261 speaker amplifiers share the secondary MI2S
	 * (stock: TDM-LPAIF-RX-SECONDARY on gpio121-124). It runs as plain
	 * stereo I2S here: each amplifier's tuning selects its own half of
	 * the frame, as the stock tuning's I2SCTRL1 channel select does.
	 */
	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		pinctrl-0 = <&i2s1_default>;
		pinctrl-names = "default";

		model = "OnePlus-Pad3";
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC5", "MIC BIAS3",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT2", "ADC3_OUTPUT",
				"TX SWR_INPUT3", "ADC4_OUTPUT";

		/*
		 * The six amplifiers share one TDM frame of 8 x 32-bit slots
		 * (stock TDM-LPAIF-RX-SECONDARY); each plays the slot of its
		 * awinic,audio-channel.
		 */
		speaker-dai-link {
			link-name = "Secondary TDM Playback";

			codec {
				sound-dai = <&amp_ch0>, <&amp_ch1>, <&amp_ch2>,
					    <&amp_ch3>, <&amp_ch5>, <&amp_ch6>;
				dai-tdm-slot-num = <8>;
				dai-tdm-slot-width = <32>;
				dai-tdm-slot-rx-mask = <1 1 1 1 0 1 1 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
				dai-tdm-slot-num = <8>;
				dai-tdm-slot-width = <32>;
				dai-tdm-slot-rx-mask = <1 1 1 1 1 1 1 1>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			codec {
				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/* The USB-C headset (stock CODEC_DMA-LPAIF_RXTX-RX-0) */
		wcd-playback-dai-link {
			link-name = "WCD Playback";

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};

	wcn7860-pmu {
		compatible = "qcom,wcn7860-pmu";

		pinctrl-0 = <&wlan_en>, <&bt_default>;
		pinctrl-names = "default";

		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;

		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s5f_0p85>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

		clocks = <&rpmhcc RPMH_RF_CLK1>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};

	/*
	 * The subboard thermistor, the in-kernel stand-in for the stock
	 * shell-temperature estimate (vendor horae_shell_temp) that drives
	 * the stock charge-current strategy. The stock CGCL table steps the
	 * PD/QC input current down at 42 C (2 A), 43 C (1.5 A) and 44 C
	 * (1.2 A, then the session exits, oplus,pd_strategy_data with
	 * USE_SHELL_TEMP in oplus-chg-erhai-common.dtsi).
	 */
	board_temp: thermal-sensor-board {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&pmk8550_vadc 0x74d>;
		io-channel-names = "sensor-channel";
	};

	/*
	 * The thermistor on the battery connector (BTB), the cell's own
	 * temperature sense line, as the stock charge controller reads it
	 * (AMUX2 BAT2, 100K pull-up).
	 */
	batt_temp: thermal-sensor-batt {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&pmk8550_vadc 0x74c>;
		io-channel-names = "sensor-channel";
	};

	thermal-zones {
		/*
		 * Charge-current mitigation, the in-tree counterpart of the
		 * stock thermal-engine shell-temp -> charge-current policy.
		 * The first step sits at the stock 42 C first reduction;
		 * with 500000 uA of granularity per state the steps are 2 C
		 * apart, matching the stock shell-temp cadence. The board
		 * thermistor runs a few degrees above the shell, so the
		 * table engages earlier than the stock estimate at the same
		 * shell temperature; recalibrate when a shell sensor is
		 * ported.
		 */
		chg-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			thermal-sensors = <&board_temp>;

			trips {
				chg_3a9: trip-42 {
					temperature = <42000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_3a4: trip-44 {
					temperature = <44000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_2a9: trip-46 {
					temperature = <46000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_2a4: trip-48 {
					temperature = <48000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_1a9: trip-50 {
					temperature = <50000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_1a4: trip-52 {
					temperature = <52000>;
					hysteresis = <2000>;
					type = "passive";
				};

				chg_900ma: trip-54 {
					temperature = <54000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&chg_3a9>;
					cooling-device = <&pmic_glink 1 1>;
				};

				map1 {
					trip = <&chg_3a4>;
					cooling-device = <&pmic_glink 2 2>;
				};

				map2 {
					trip = <&chg_2a9>;
					cooling-device = <&pmic_glink 3 3>;
				};

				map3 {
					trip = <&chg_2a4>;
					cooling-device = <&pmic_glink 4 4>;
				};

				map4 {
					trip = <&chg_1a9>;
					cooling-device = <&pmic_glink 5 5>;
				};

				map5 {
					trip = <&chg_1a4>;
					cooling-device = <&pmic_glink 6 6>;
				};

				map6 {
					trip = <&chg_900ma>;
					cooling-device = <&pmic_glink 7 7>;
				};
			};
		};

		/*
		 * The battery temperature, as the stock firmware tracks it
		 * (svooc_mos_btb_usr): the user_space governor hands the
		 * readings to the thermal HAL and the single passive trip
		 * is a 125 C sentinel. The stock node's wake-capable-sensor
		 * flag is omitted: the IIO-backed generic-adc-thermal
		 * sensor does not implement it.
		 */
		batt-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-governor = "user_space";
			thermal-sensors = <&batt_temp>;

			trips {
				batt_sentinel: trip-125 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};
	};
};

/* The ADSP firmware of this tablet loads 0x5080000 bytes from the carveout. */
&adspslpi_mem {
	reg = <0x0 0x9ee00000 0x0 0x5080000>;
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <4000000>;
		};

		/*
		 * The camera I/O rail is also the panel's touch I/O (tvdd)
		 * rail on stock: keep it on, so that a camera powering down
		 * cannot take it from the panel.
		 */
		vreg_l4b_1p8: ldo4 {
			regulator-name = "vreg_l4b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l5b_3p1: ldo5 {
			regulator-name = "vreg_l5b_3p1";
			regulator-min-microvolt = <3100000>;
			regulator-max-microvolt = <3148000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* Rear camera autofocus rail */
		vreg_l9b_2p8: ldo9 {
			regulator-name = "vreg_l9b_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/*
		 * The front camera's core rail is also the panel's vdd rail on
		 * stock, which keeps it on from boot: keep it on here too.
		 */
		vreg_l11b_1p2: ldo11 {
			regulator-name = "vreg_l11b_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		/*
		 * Stock asks 1.9 V, its maximum for this rail, which falls
		 * between two 8 mV steps of this LDO: the step below.
		 */
		vreg_l12b_1p9: ldo12 {
			regulator-name = "vreg_l12b_1p9";
			regulator-min-microvolt = <1896000>;
			regulator-max-microvolt = <1896000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l15b_1p8: ldo15 {
			regulator-name = "vreg_l15b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* Analogue rail of both cameras */
		vreg_l16b_2p8: ldo16 {
			regulator-name = "vreg_l16b_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "d";

		/* The stock Wi-Fi driver asks 876-1036 mV of the WCN's AON rail. */
		vreg_s4d_0p85: smps4 {
			regulator-name = "vreg_s4d_0p85";
			regulator-min-microvolt = <876000>;
			regulator-max-microvolt = <1036000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1d_1p2: ldo1 {
			regulator-name = "vreg_l1d_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2d_0p88: ldo2 {
			regulator-name = "vreg_l2d_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-2 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "f";

		/* The stock Wi-Fi driver asks 876-1000 mV of the WCN's digital rail. */
		vreg_s5f_0p85: smps5 {
			regulator-name = "vreg_s5f_0p85";
			regulator-min-microvolt = <876000>;
			regulator-max-microvolt = <1000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1f_0p88: ldo1 {
			regulator-name = "vreg_l1f_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2f_1p2: ldo2 {
			regulator-name = "vreg_l2f_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3f_1p8: ldo3 {
			regulator-name = "vreg_l3f_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-3 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "g";

		/*
		 * The stock Wi-Fi driver asks 1.86-2 V of the WCN's RF rail:
		 * from 1856 mV, the step below.
		 */
		vreg_s3g_1p8: smps3 {
			regulator-name = "vreg_s3g_1p8";
			regulator-min-microvolt = <1856000>;
			regulator-max-microvolt = <2000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
		};

		vreg_l3g_1p2: ldo3 {
			regulator-name = "vreg_l3g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1256000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-4 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "i";

		/* The stock Wi-Fi driver asks 1312-1340 mV of the WCN's RF rail. */
		vreg_s7i_1p2: smps7 {
			regulator-name = "vreg_s7i_1p2";
			regulator-min-microvolt = <1312000>;
			regulator-max-microvolt = <1340000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* Rear camera core rail */
		vreg_l1i_1p2: ldo1 {
			regulator-name = "vreg_l1i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2i_1p2: ldo2 {
			regulator-name = "vreg_l2i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3i_0p88: ldo3 {
			regulator-name = "vreg_l3i_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "j";

		/* The stock UFS PHY driver asks 912 mV of this 880-920 mV rail. */
		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <912000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * Rear SmartSens C658 on CCI0 master 1 into CSIPHY4, front SmartSens D154
 * on QUPv3 SE9 into CSIPHY5, four lanes each, as the stock camera
 * overlay wires them. The CSIPHYs take their 0.9 V rails from L3I (rear)
 * and L1F (front) and their 1.2 V rail from L3G.
 */
&camss {
	status = "okay";
};

&camss_csiphy4_in_port {
	camss_csiphy4_inep: endpoint {
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&csiphy4_out_ep>;
	};
};

&camss_csiphy5_in_port {
	camss_csiphy5_inep: endpoint {
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&csiphy5_out_ep>;
	};
};

/* Stock drives only master 1; gpio113/114 of master 0 stay unclaimed */
&cci0 {
	pinctrl-0 = <&cci0_1_default>;
	pinctrl-1 = <&cci0_1_sleep>;

	status = "okay";
};

&cci0_i2c0 {
	status = "disabled";
};

&cci0_i2c1 {
	clock-frequency = <400000>;

	/* Rear, SmartSens chip ID 0xc658, 8-bit address 0x6c in stock */
	camera@36 {
		compatible = "smartsens,c658";
		reg = <0x36>;

		/* CAMIF_MCLK1 on gpio90, 19.2 MHz */
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
		assigned-clock-rates = <19200000>;

		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;

		/* CAM_RESET1 */
		reset-gpios = <&pm8550ve_i_gpios 5 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_l16b_2p8>;
		dvdd-supply = <&vreg_l1i_1p2>;
		dovdd-supply = <&vreg_l4b_1p8>;

		orientation = <1>;
		rotation = <0>;

		lens-focus = <&cam_rear_vcm>;
		flash-leds = <&flash_rear_0>, <&flash_rear_1>;

		pinctrl-0 = <&cam1_default>, <&cam_rear_reset_default>;
		pinctrl-names = "default";

		port {
			cam_rear_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <662400000>;
				remote-endpoint = <&csiphy4_in_ep>;
			};
		};
	};

	/* Autofocus, 8-bit address 0x18 in stock */
	cam_rear_vcm: actuator@c {
		compatible = "giantec,gt9772";
		reg = <0x0c>;

		vdd-supply = <&vreg_l9b_2p8>;
	};

	/*
	 * Module calibration, 8-bit address 0xa0 in stock, data up to 0x6d2a.
	 * Stock powers every camera rail to read it; the I/O rail is always
	 * on, so the autofocus rail is the one this node switches.
	 */
	eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;

		vcc-supply = <&vreg_l9b_2p8>;
		read-only;
	};
};

&csiphy4 {
	vdda-0p9-supply = <&vreg_l3i_0p88>;
	vdda-1p2-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&csiphy4_in_port {
	csiphy4_in_ep: endpoint {
		bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&cam_rear_ep>;
	};
};

&csiphy4_out_port {
	csiphy4_out_ep: endpoint {
		remote-endpoint = <&camss_csiphy4_inep>;
	};
};

&csiphy5 {
	vdda-0p9-supply = <&vreg_l1f_0p88>;
	vdda-1p2-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&csiphy5_in_port {
	csiphy5_in_ep: endpoint {
		bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&cam_front_ep>;
	};
};

&csiphy5_out_port {
	csiphy5_out_ep: endpoint {
		remote-endpoint = <&camss_csiphy5_inep>;
	};
};

/* The touchscreen's SPI engine runs in GSI mode, on GPI DMA. */
&gpi_dma1 {
	status = "okay";
};

/* The front camera's SE9 I2C engine runs in GSI mode, on GPI DMA. */
&gpi_dma2 {
	status = "okay";
};

&gpu {
	status = "okay";
};

/*
 * The zap shader is signed for OnePlus; the stock vendor partition keeps it
 * as gen80000_zap.mbn.
 */
&gpu_zap_shader {
	firmware-name = "qcom/sm8750/erhai/gen80000_zap.mbn";
};

/*
 * The stock kernel runs the panel on two DSI controllers, four lanes each,
 * the second in sync with the first, and lights it with two KTZ8868
 * controllers on two I2C buses.
 */
&i2c11 {
	status = "okay";

	backlight_secondary: backlight@11 {
		compatible = "kinetic,ktz8868b";
		reg = <0x11>;

		vin-supply = <&vph_pwr>;
		vddio-supply = <&vreg_l12b_1p9>;

		status = "okay";
	};
};

&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_0 {
	status = "okay";

	backlight: backlight@11 {
		compatible = "kinetic,ktz8868a";
		reg = <0x11>;

		enable-gpios = <&tlmm 15 GPIO_ACTIVE_HIGH>;

		vin-supply = <&vph_pwr>;
		vddio-supply = <&vreg_l12b_1p9>;

		pinctrl-0 = <&ktz8868_en_active>;
		pinctrl-1 = <&ktz8868_en_suspend>;
		pinctrl-names = "default", "sleep";

		status = "okay";
	};
};

/*
 * The SuperVOOC 80 W stage: the SC8547A charge pump on hub i2c8, the
 * second pump on hub i2c2, and the WCD939x USBSS that switches the
 * connector's D+/D- to the pump's VOOC PHY (oplus-chg-erhai-common.dtsi,
 * fdt.dts). The thermistors sit on PMIH010X and read through the
 * PMK8550 ADC as the stock vadc capture numbers them.
 */
&i2c3 {
	status = "okay";

	wcd_usbss: typec-mux@e {
		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
		reg = <0xe>;

		vdd-supply = <&vreg_l15b_1p8>;
		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;

		mode-switch;
		orientation-switch;
		#mux-state-cells = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wcd_usbss_sbu_mux: endpoint {
					remote-endpoint = <&pmic_glink_sbu>;
				};
			};

			port@1 {
				reg = <1>;

				wcd_usbss_headset_out: endpoint {
					remote-endpoint = <&wcd_codec_headset_in>;
				};
			};
		};
	};
};

/* Only the front camera and its in-sensor EEPROM sit on this bus */
&i2c9 {
	clock-frequency = <400000>;

	status = "okay";

	/* Front, SmartSens chip ID 0xd154, 8-bit address 0x20 in stock */
	camera@10 {
		compatible = "smartsens,d154";
		reg = <0x10>;

		/* CAMIF_MCLK4 on gpio93, 19.2 MHz */
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clock-rates = <19200000>;

		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;

		/* CAM_RESET4 */
		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_l16b_2p8>;
		dvdd-supply = <&vreg_l11b_1p2>;
		dovdd-supply = <&vreg_l4b_1p8>;

		orientation = <0>;
		rotation = <0>;

		pinctrl-0 = <&cam4_default>, <&cam_front_reset_default>;
		pinctrl-names = "default";

		port {
			cam_front_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <330000000>;
				remote-endpoint = <&csiphy5_in_ep>;
			};
		};
	};
};

&i2c_hub_2 {
	clock-frequency = <400000>;
	status = "okay";

	charge_pump_second: charge-pump@6f {
		compatible = "southchip,sc8547";
		reg = <0x6f>;

		southchip,vbat-ovp-microvolt = <4850000>;
		southchip,vbus-ovp-microvolt = <10500000>;
		southchip,ibus-ocp-microamp = <4500000>;
		southchip,switching-frequency-hz = <600000>;
	};
};

&i2c_hub_8 {
	clock-frequency = <400000>;
	status = "okay";

	charge_pump_main: charge-pump@6f {
		compatible = "southchip,sc8547a";
		reg = <0x6f>;

		interrupts-extended = <&tlmm 163 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-0 = <&cp_main_irq_default>;
		pinctrl-names = "default";

		southchip,vbat-ovp-microvolt = <4850000>;
		southchip,vbus-ovp-microvolt = <10500000>;
		southchip,ibus-ocp-microamp = <4500000>;
		southchip,switching-frequency-hz = <500000>;
		southchip,always-otg-en;

		vooc-phy {
			mux-states = <&wcd_usbss 1>;

			io-channels = <&pmk8550_vadc 0x747>,
				      <&pmk8550_vadc 0x74c>,
				      <&pmk8550_vadc 0x74d>,
				      <&pmk8550_vadc 0x74b>;
			io-channel-names = "usb-connector",
					   "battery-connector",
					   "board",
					   "mos";

			southchip,secondary-pump = <&charge_pump_second>;

			/* The VOOC 5.0 curve the 80 W adapter reports. */
			oneplus,svooc-battery-curve = <4664000 1100000>,
						      <4664000 2600000>,
						      <3414000 7300000>;

			/* The driver's total cap; 3.1 A per pump, under the
			 * per-pump cap, 55 W under the power cap at the
			 * adapter's 8.5 V. The stock 80 W adapter's curve
			 * allows more, so the taper and the curve shape the
			 * rest of the charge. */
			oneplus,svooc-max-microamp = <6200000>;

			/*
			 * Sessions follow the stock board data; the driver's
			 * debugfs stock_strategy switch turns it off for the
			 * next session. Numbers from the stock DT
			 * (notes/erhai/step0/captures/fdt.dts) and the Lineage
			 * oplus charger.
			 */
			oneplus,svooc-stock-strategy;
			/*
			 * After a full session, top up at the raised voltage
			 * limit of fast-full-charge; debugfs fast_full_charge
			 * turns it off for the next session.
			 */
			oneplus,svooc-fast-full-charge;

			/*
			 * SuperVOOC adapter models and their power,
			 * oplus_chg_vooc.c:467-512; VOOC-only models have none.
			 */
			oneplus,svooc-adapters = <0x11 0x12 50000000>,
						 <0x14 0x14 65000000>,
						 <0x1a 0x1b 33000000>,
						 <0x1c 0x1c 45000000>,
						 <0x1d 0x1e 44000000>,
						 <0x21 0x21 50000000>,
						 <0x22 0x22 44000000>,
						 <0x23 0x23 50000000>,
						 <0x24 0x27 55000000>,
						 <0x28 0x28 65000000>,
						 <0x2a 0x2a 65000000>,
						 <0x2b 0x2b 66000000>,
						 <0x2c 0x2e 67000000>,
						 <0x31 0x31 50000000>,
						 <0x32 0x32 120000000>,
						 <0x33 0x33 50000000>,
						 <0x35 0x35 65000000>,
						 <0x36 0x36 66000000>,
						 <0x37 0x3a 88000000>,
						 <0x3b 0x3e 100000000>,
						 <0x47 0x48 120000000>,
						 <0x49 0x4a 33000000>,
						 <0x4b 0x4e 80000000>,
						 <0x51 0x51 125000000>,
						 <0x61 0x61 33000000>,
						 <0x62 0x62 50000000>,
						 <0x63 0x63 65000000>,
						 <0x64 0x64 66000000>,
						 <0x65 0x65 80000000>,
						 <0x66 0x66 65000000>,
						 <0x67 0x68 125000000>,
						 <0x69 0x6a 100000000>,
						 <0x6b 0x6b 120000000>,
						 <0x6c 0x6d 67000000>,
						 <0x6e 0x6e 65000000>;

			/* soc_range, fdt.dts:25837 */
			oneplus,svooc-soc-bands = <20 35 55 75 85 90>;
			/*
			 * vooc_low_temp, little_cold, cool, little_cool,
			 * little_cool_high, normal_low, normal_high and high
			 * temperatures, fdt.dts:25808-25817. The driver still
			 * stops at 44 C, so the warm band stays unused.
			 */
			oneplus,svooc-temp-bands = <0 50 120 160 210 350 440 500>;
			/* full_voltage per band, at once and held, fdt.dts:25836 */
			oneplus,svooc-full-microvolt = <4530000 4520000>,
						       <4555000 4545000>,
						       <4555000 4545000>,
						       <4555000 4545000>,
						       <4560000 4550000>,
						       <4555000 4545000>,
						       <4140000 4130000>;
			/* vbatt-ov-thr-mv, fdt.dts:33535 */
			oneplus,svooc-overvoltage-microvolt = <4600000>;
			/* fastchg_timeout_time_init 301880 x 100 ms, fdt.dts:25826 */
			oneplus,svooc-timeout-sec = <30188>;

			/* svooc_charge_strategy, fdt.dts:25856-25917 */
			charge-curves {
				/* strategy_soc_0_to_50, fdt.dts:25859-25865 */
				soc-band-0 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4150000 3800000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4510000 2600000>,
						      <4510000 2500000>,
						      <4510000 2000000>,
						      <4510000 1500000>,
						      <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4150000 4800000>,
						      <4150000 4500000>,
						      <4150000 4000000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4200000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4150000 4800000>,
						      <4150000 4500000>,
						      <4150000 4000000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4200000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4050000 7300000>,
						      <4230000 6100000>,
						      <4230000 5000000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4050000 7300000>,
						      <4230000 6100000>,
						      <4230000 5000000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4200000 6100000>,
						      <4200000 6000000>,
						      <4200000 5000000>,
						      <4230000 4800000>,
						      <4230000 4500000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1400000>;
					/* strategy_temp_warm */
					temp-band-6 = <4120000 3200000>,
						      <4120000 3000000>,
						      <4120000 2500000>,
						      <4120000 2000000>,
						      <4120000 1500000>,
						      <4130000 1000000>;
				};
				/* strategy_soc_0_to_50_mid, fdt.dts:25869-25875 */
				soc-band-1 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4150000 3800000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4510000 2600000>,
						      <4510000 2500000>,
						      <4510000 2000000>,
						      <4510000 1500000>,
						      <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4150000 4800000>,
						      <4150000 4500000>,
						      <4150000 4000000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4200000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4150000 4800000>,
						      <4150000 4500000>,
						      <4150000 4000000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4200000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4050000 7300000>,
						      <4230000 6100000>,
						      <4230000 5000000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4050000 7300000>,
						      <4230000 6100000>,
						      <4230000 5000000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4200000 6100000>,
						      <4200000 6000000>,
						      <4200000 5000000>,
						      <4230000 4800000>,
						      <4230000 4500000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1400000>;
					/* strategy_temp_warm */
					temp-band-6 = <4120000 3200000>,
						      <4120000 3000000>,
						      <4120000 2500000>,
						      <4120000 2000000>,
						      <4120000 1500000>,
						      <4130000 1000000>;
				};
				/* strategy_soc_0_to_50_high, fdt.dts:25879-25885 */
				soc-band-2 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4510000 2000000>,
						      <4510000 1500000>,
						      <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4150000 4000000>,
						      <4150000 3500000>,
						      <4150000 3000000>,
						      <4200000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4050000 7300000>,
						      <4230000 6100000>,
						      <4230000 5000000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4200000 6100000>,
						      <4200000 6000000>,
						      <4200000 5000000>,
						      <4230000 4800000>,
						      <4230000 4500000>,
						      <4230000 4000000>,
						      <4380000 3900000>,
						      <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1400000>;
					/* strategy_temp_warm */
					temp-band-6 = <4120000 3200000>,
						      <4120000 3000000>,
						      <4120000 2500000>,
						      <4120000 2000000>,
						      <4120000 1500000>,
						      <4130000 1000000>;
				};
				/* strategy_soc_50_to_75, fdt.dts:25889-25895 */
				soc-band-3 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4510000 1500000>,
						      <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4380000 3500000>,
						      <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1400000>;
					/* strategy_temp_warm */
					temp-band-6 = <4130000 1000000>;
				};
				/* strategy_soc_75_to_85, fdt.dts:25899-25905 */
				soc-band-4 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4380000 3000000>,
						      <4535000 2900000>,
						      <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1400000>;
					/* strategy_temp_warm */
					temp-band-6 = <4130000 1000000>;
				};
				/* strategy_soc_85_to_90, fdt.dts:25909-25915 */
				soc-band-5 {
					/* strategy_temp_little_cold */
					temp-band-0 = <4520000 1000000>;
					/* strategy_temp_cool */
					temp-band-1 = <4545000 1000000>;
					/* strategy_temp_little_cool */
					temp-band-2 = <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_little_cool_high */
					temp-band-3 = <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_low */
					temp-band-4 = <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_normal_high */
					temp-band-5 = <4535000 2500000>,
						      <4535000 2000000>,
						      <4535000 1500000>,
						      <4545000 1000000>;
					/* strategy_temp_warm */
					temp-band-6 = <4130000 1000000>;
				};
			};

			/*
			 * svooc_lcf_strategy, fdt.dts:25842-25854; stock reads
			 * the shell temperature, the driver the battery's.
			 */
			low-current-full {
				temp-bands = <0 50 120 160 210 380 440>;
				temp-band-0 = <600000 4520000>, <575000 4510000>,
					      <550000 4500000>, <525000 4490000>,
					      <500000 4480000>;
				temp-band-1 = <1750000 4545000>, <1700000 4540000>,
					      <1650000 4525000>, <1550000 4515000>,
					      <1450000 4505000>;
				temp-band-2 = <1750000 4545000>, <1700000 4540000>,
					      <1600000 4525000>, <1500000 4515000>,
					      <1350000 4505000>;
				temp-band-3 = <1950000 4545000>, <1900000 4540000>,
					      <1800000 4525000>, <1700000 4515000>,
					      <1550000 4505000>;
				temp-band-4 = <1950000 4545000>, <1900000 4540000>,
					      <1800000 4525000>, <1700000 4515000>,
					      <1550000 4505000>;
				temp-band-5 = <2600000 4540000>, <2400000 4510000>,
					      <2000000 4500000>, <1500000 4490000>,
					      <1000000 4480000>;
			};

			/* The common charge node's FFC, fdt.dts:33537-33543 */
			fast-full-charge {
				temp-bands = <120 210 350 440>;
				skip-microvolt = <4485000>;
				/* fv-mv for these bands, fdt.dts:33519-33522 */
				restore-microvolt = <4490000 4490000 4470000>;
				steps = <4630000 1500000 4540000 1300000>,
					<4630000 1500000 4540000 1300000>,
					<4630000 1500000 4540000 1300000>,
					<4630000 1000000 4540000 900000>,
					<4630000 1000000 4540000 900000>,
					<4630000 1000000 4540000 900000>;
			};
		};
	};
};

&pmk8550_vadc {
	/* The stock numbers are the PMK8550's view of the PMIH010X AMUX inputs.
	 * Stock marks these channels qcom,adc5-gen4: they return ratiometric
	 * codes over the full 16 bits. */
	channel@747 {
		reg = <0x747>;
		label = "usb-connector";
		qcom,adc5-gen4;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	channel@74c {
		reg = <0x74c>;
		label = "battery-connector";
		qcom,adc5-gen4;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	channel@74d {
		reg = <0x74d>;
		label = "board";
		qcom,adc5-gen4;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	channel@74b {
		reg = <0x74b>;
		label = "mos";
		qcom,adc5-gen4;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

/*
 * The CPS8601 stylus charger, as oplus-chg-erhai-common.dtsi:1825-1869 and
 * the live stock fdt (pencil-wireless-charger@41) describe it.
 */
&i2c_hub_3 {
	status = "okay";

	pen-charger@41 {
		compatible = "convenientpower,cps8601";
		reg = <0x41>;

		interrupts-extended = <&tlmm 172 IRQ_TYPE_EDGE_FALLING>;

		vin-supply = <&pen_boost>;

		wakeup-gpios = <&tlmm 106 GPIO_ACTIVE_HIGH>;
		scan-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&tlmm 107 GPIO_ACTIVE_HIGH>;

		oneplus,idle-microvolt = <7000000>;
		oneplus,charge-microvolt = <10000000>;

		pinctrl-0 = <&pen_charger_default>;
		pinctrl-names = "default";
	};
};

&i2c_hub_4 {
	clock-frequency = <400000>;

	status = "okay";

	amp_ch3: audio-codec@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;

		sound-name-prefix = "Speaker Ch3";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <3>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};

	amp_ch1: audio-codec@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;

		sound-name-prefix = "Speaker Ch1";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <1>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};

	amp_ch5: audio-codec@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;

		sound-name-prefix = "Speaker Ch5";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <5>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};
};

&i2c_hub_9 {
	clock-frequency = <400000>;

	status = "okay";

	amp_ch0: audio-codec@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;

		sound-name-prefix = "Speaker Ch0";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <0>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};

	amp_ch2: audio-codec@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;

		sound-name-prefix = "Speaker Ch2";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <2>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};

	amp_ch6: audio-codec@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;

		sound-name-prefix = "Speaker Ch6";
		firmware-name = "qcom/sm8750/erhai/aw88261_acf.bin";

		awinic,audio-channel = <6>;
		awinic,sync-flag;

		#sound-dai-cells = <0>;
	};
};

&mdss {
	/*
	 * The display is handed over as the bootloader runs it, reading the
	 * splash memory, and with both the power domains the bootloader has
	 * on: without the second one the control path sat in reset, and no
	 * frame of ours came out until the whole display was reset.
	 */
	memory-region = <&cont_splash_mem>;
	power-domains = <&dispcc MDSS_GDSC>, <&dispcc MDSS_INT2_GDSC>;

	status = "okay";
};

&mdss_mdp {
	/*
	 * The panel's 144 Hz mode needs the four mixers this display clock
	 * can drive, which the stock kernel runs as one source pipe per
	 * mixer. The driver's multi-rect pairing instead shares one pipe
	 * between a pair of mixers, and the panel garbles at 144 Hz on
	 * that topology.
	 */
	qcom,dpu-disable-multirect;
};

&mdss_dp0 {
	status = "okay";
};

&mdss_dp0_out {
	/* The stock link rates (fdt displayport-controller@af54000) */
	link-frequencies = /bits/ 64 <1620000000 2700000000
				      5400000000 8100000000>;
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;

	status = "okay";

	display_panel: panel@0 {
		compatible = "oneplus,erhai-nt36536", "novatek,nt36536";
		reg = <0>;

		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
		error-flag-gpios = <&tlmm 86 GPIO_ACTIVE_HIGH>,
				   <&tlmm 87 GPIO_ACTIVE_HIGH>;

		vddio-supply = <&vreg_l12b_1p9>;

		/* The LCD bias comes from the backlight controller, which
		 * the boost converters feed.
		 */
		avdd-supply = <&vph_pwr>;
		avee-supply = <&vph_pwr>;

		backlight = <&backlight>;

		pinctrl-0 = <&sde_dsi_active &sde_err_flag_active &sde_esync0_active>;
		pinctrl-1 = <&sde_dsi_suspend &sde_err_flag_suspend &sde_esync0_suspend>;
		pinctrl-names = "default", "sleep";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel_in_0: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;

				panel_in_1: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in_0>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l3i_0p88>;

	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;

	/* The second controller is in sync with the first, so its PLL
	 * clocks come from the first PHY.
	 */
	clocks = <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK>,
		 <&dispcc DISP_CC_MDSS_ESC1_CLK>,
		 <&dispcc DISP_CC_MDSS_AHB_CLK>,
		 <&gcc GCC_DISP_HF_AXI_CLK>,
		 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>,
		 <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>,
		 <&dispcc DISP_CC_ESYNC1_CLK>,
		 <&dispcc DISP_CC_OSC_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_CLK_SRC>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>;

	status = "okay";
};

&mdss_dsi1_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in_1>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l3i_0p88>;

	status = "okay";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

/*
 * The rear camera's two flash LEDs on channels 1 and 2, at the stock 1.5 A
 * flash and 500 mA torch per LED and the longest flash the block allows
 */
&pm8550_flash {
	status = "okay";

	flash_rear_0: led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		function-enumerator = <0>;
		led-sources = <1>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1500000>;
		flash-max-timeout-us = <1280000>;
	};

	flash_rear_1: led-1 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		function-enumerator = <1>;
		led-sources = <2>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1500000>;
		flash-max-timeout-us = <1280000>;
	};
};

&pm8550_gpios {
	key_vol_down_default: key-vol-down-default-state {
		pins = "gpio6";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

&pmih0108 {
	/*
	 * The stock thresholds of the battery BCL (stock fdt, the pmic@7
	 * bcl@4700 zones): ibat 13500 / 15000 mA and vbat 2800 / 2600 mV at
	 * levels 0 / 1. The stock third vbat level (2300 mV) has no
	 * counterpart in the two-level monitor and keeps the bootloader's
	 * value.
	 */
	sensor@4700 {
		overcurrent-thresholds-microamp = <13500000 15000000>;
		undervoltage-thresholds-microvolt = <2800000 2600000>;
	};
};

&pmih0108_eusb2_repeater {
	qcom,tune-usb2-amplitude = /bits/ 8 <0xb>;
	qcom,tune-usb2-disc-thres = /bits/ 8 <0x7>;
	qcom,tune-usb2-preem = /bits/ 8 <0x3>;
	qcom,squelch-detector-bp = <(-2000)>;

	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEUP>;

	status = "okay";
};

/*
 * The amplifiers lock their PLL to the bit clock when they start, before
 * the ADSP starts the I2S port, so the bit clock is requested from the
 * PRM ahead of it.
 */
&q6apmbedai {
	#address-cells = <1>;
	#size-cells = <0>;

	dai@12 {
		reg = <SECONDARY_MI2S_RX>;
		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "bclk";
	};
};

/* The stock kernel drives the touchscreen's chip select at 4 mA. */
&qup_spi4_cs {
	drive-strength = <4>;
};

/* The touchscreen's bus, spi4, is on this wrapper. */
&qupv3_1 {
	status = "okay";
};

/* The second backlight controller's bus, i2c11, is on this wrapper. */
&qupv3_2 {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/oneplus/erhai/adsp.mdt",
			"qcom/sm8750/oneplus/erhai/adsp_dtb.mdt";

	status = "okay";
};

&spi4 {
	status = "okay";

	/*
	 * NT36536 in the panel (in-cell): powered and reset with the panel,
	 * so it has no supplies and no reset line of its own. The controller
	 * has no flash and takes its firmware at every power-on.
	 */
	touchscreen@0 {
		compatible = "novatek,NVT-ts-spi";
		reg = <0>;

		spi-max-frequency = <12000000>;
		irq-gpios = <&tlmm 162 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&ts_int_active>;
		pinctrl-names = "default";

		novatek,pen-support;
		/*
		 * The stock tp node: touchpanel,pen-max-pressure 65533 levels,
		 * and the default stylus type its driver announces at boot.
		 */
		novatek,pen-max-pressure = <65532>;
		novatek,pen-type = <1>;

		panel = <&display_panel>;

		firmware-name = "novatek/erhai/novatek_nt36536_fw.bin";
		/*
		 * The controller's own axes are the portrait frame of the stock
		 * tp node's panel-coords (x 24000 across the short side). The
		 * stock recovery maps them onto the 3392x2400 scanout with its
		 * ROTATION_RIGHT touch rotation: screen x = raw y, screen y =
		 * max - raw x.
		 */
		touchscreen-size-x = <24000>;
		touchscreen-size-y = <33920>;
		/* The 274 x 193 mm panel, in the same axes. */
		touchscreen-x-mm = <193>;
		touchscreen-y-mm = <274>;
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;

		/* A double tap on the blanked panel wakes the system. */
		wakeup-source;
	};
};

&spmi_bus {
	/*
	 * Only the PM8550VE-F GPIOs are described: the WCN7860 Bluetooth
	 * enable line is its GPIO 3.
	 */
	pm8550ve_f: pmic@5 {
		compatible = "qcom,pm8550ve", "qcom,spmi-pmic";
		reg = <0x5 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8550ve_f_gpios: gpio@8800 {
			compatible = "qcom,pm8550ve-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pm8550ve_f_gpios 0 0 6>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	/* The rear camera's reset line is its GPIO 5. */
	pm8550ve_i: pmic@8 {
		compatible = "qcom,pm8550ve", "qcom,spmi-pmic";
		reg = <0x8 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8550ve_i_gpios: gpio@8800 {
			compatible = "qcom,pm8550ve-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pm8550ve_i_gpios 0 0 6>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&pm8550ve_f_gpios {
	bt_default: bt-default-state {
		pins = "gpio3";
		function = "normal";
		input-disable;
		output-enable;
		output-low;
		bias-disable;
		power-source = <1>;
	};
};

&pm8550ve_i_gpios {
	cam_rear_reset_default: cam-rear-reset-default-state {
		pins = "gpio5";
		function = "normal";
		input-disable;
		output-enable;
		output-low;
		bias-disable;
		power-source = <1>;
	};
};

&swr1 {
	status = "okay";

	/* WCD9395 RX */
	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;

		/*
		 * WCD9395 RX Port 1 (HPH_L/R)      <=> SWR1 Port 1 (HPH_L/R)
		 * WCD9395 RX Port 2 (CLSH)         <=> SWR1 Port 2 (CLSH)
		 * WCD9395 RX Port 3 (COMP_L/R)     <=> SWR1 Port 3 (COMP_L/R)
		 * WCD9395 RX Port 4 (LO)           <=> SWR1 Port 4 (LO)
		 * WCD9395 RX Port 5 (DSD_L/R)      <=> SWR1 Port 5 (DSD_L/R)
		 * WCD9395 RX Port 6 (HIFI_PCM_L/R) <=> SWR1 Port 9 (HIFI_PCM_L/R)
		 */
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

&swr2 {
	status = "okay";

	/* WCD9395 TX */
	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;

		/*
		 * WCD9395 TX Port 1 (ADC1,2,3,4)         <=> SWR2 Port 2 (TX SWR_INPUT 0,1,2,3)
		 * WCD9395 TX Port 2 (ADC3,4 & DMIC0,1)   <=> SWR2 Port 2 (TX SWR_INPUT 0,1,2,3)
		 * WCD9395 TX Port 3 (DMIC0,1,2,3 & MBHC) <=> SWR2 Port 3 (TX SWR_INPUT 4,5,6,7)
		 * WCD9395 TX Port 4 (DMIC4,5,6,7)        <=> SWR2 Port 4 (TX SWR_INPUT 8,9,10,11)
		 */
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

&tlmm {
	/* Reserved I/Os that are not accessible from the application processor */
	gpio-reserved-ranges = <36 4>, <74 1>;

	/*
	 * The panel's reset, error-flag and sync lines, as the stock kernel
	 * sets them for its primary display, and the enable lines of the
	 * backlight controller. The panel driver takes the reset and reads
	 * the error flags; the rest the bootloader already set, and the
	 * states hold them across suspend. The stock kernel muxes the first
	 * error flag as tearing effect, which the video-mode panel does not
	 * drive (its setup never turns it on) and the display controller
	 * does not use in video mode; it reads both flags as GPIO inputs.
	 */
	sde_dsi_active: sde-dsi-active-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	sde_dsi_suspend: sde-dsi-suspend-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_err_flag_active: sde-err-flag-active-state {
		pins = "gpio86", "gpio87";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_err_flag_suspend: sde-err-flag-suspend-state {
		pins = "gpio86", "gpio87";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_esync0_active: sde-esync0-active-state {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_esync0_suspend: sde-esync0-suspend-state {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	ktz8868_en_active: ktz8868-en-active-state {
		pins = "gpio14", "gpio15", "gpio111";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ktz8868_en_suspend: ktz8868-en-suspend-state {
		pins = "gpio14", "gpio15", "gpio111";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	wcd_default: wcd-reset-n-active-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
	};

	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	ts_int_active: ts-int-active-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	/*
	 * The SC8547A's charge interrupt, as the stock pinctrl sets it
	 * (fdt.dts charging_inter_active, pulled up).
	 */
	cp_main_irq_default: cp-main-irq-default-state {
		irq-pins {
			pins = "gpio163";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	/*
	 * The CPS8601's interrupt (pulled up, as the stock driver selects
	 * it) and its control lines in their stock default states
	 * (oplus-chg-erhai-common.dtsi, fdt.dts:6833-7058).
	 */
	pen_charger_default: pen-charger-default-state {
		int-pins {
			pins = "gpio172";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};

		ctrl-pins {
			pins = "gpio56", "gpio106", "gpio107";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};

		enable-pins {
			pins = "gpio105";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	/*
	 * The pogo data line: the UART transmits only through the line
	 * driver, its TX pin is a GPIO while the port sleeps
	 * (erhai-oplus-pogopin-kb-24924.dtsi:6-30,60-71).
	 */
	pogo_uart_active: pogo-uart-active-state {
		tx-pins {
			pins = "gpio2";
			function = "qup2_se0";
			drive-strength = <8>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio3";
			function = "qup2_se0";
			drive-strength = <2>;
			bias-disable;
		};
	};

	pogo_uart_sleep: pogo-uart-sleep-state {
		tx-pins {
			pins = "gpio2";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
		};

		rx-pins {
			pins = "gpio3";
			function = "qup2_se0";
			drive-strength = <2>;
			bias-disable;
		};
	};

	/*
	 * The line driver enable (gpio83, as the stock kernel leaves it) and
	 * the attach detection, pulled up (erhai-oplus-pogopin-kb-24924.dtsi:87-99).
	 */
	pogo_kbd_default: pogo-kbd-default-state {
		tx-en-pins {
			pins = "gpio83";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		detect-pins {
			pins = "gpio96";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	pogo_vcc_en: pogo-vcc-en-state {
		pins = "gpio85";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	i2s1_default: i2s1-default-state {
		sck-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <6>;
			bias-disable;
		};

		data0-pins {
			pins = "gpio122";
			function = "i2s1_data0";
			drive-strength = <6>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <6>;
			bias-disable;
		};

		data1-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <6>;
			bias-disable;
		};
	};

	cam_front_reset_default: cam-front-reset-default-state {
		pins = "gpio7";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/*
	 * The case's hall sensor interrupt line: an input, pulled high,
	 * driven low while the keyboard case is closed over the tablet.
	 */
	lid_default: lid-default-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

/*
 * The WCN7860 Bluetooth host interface. The stock fdt keeps this UART
 * enabled and its stock pinctrl states switch gpio24-27 to qup2_se6.
 * The Bluetooth enable line and the rails are driven by the
 * wcn7860-pmu power sequencer, which the PMU supplies tie it to.
 */
&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7860-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		max-speed = <3200000>;
	};
};

/*
 * The pogo-pin keyboard cover. The stock userspace opens this port at a
 * rate that is in no source; the stock kernel left its clock at
 * 14.7456 MHz, 16 x 921600 (display-ref/clk_summary.txt).
 */
&uart8 {
	pinctrl-0 = <&pogo_uart_active>;
	pinctrl-1 = <&pogo_uart_sleep>;
	pinctrl-names = "default", "sleep";

	status = "okay";

	mcu {
		compatible = "oneplus,erhai-pogo-keyboard";

		vcc-supply = <&pogo_vcc>;
		tx-enable-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
		detect-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;

		max-speed = <921600>;

		oneplus,touchpad-size = <2764 1630>;
		oneplus,touchpad-resolution = <23 23>;

		pinctrl-0 = <&pogo_kbd_default>;
		pinctrl-names = "default";
	};
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&usb {
	/*
	 * The UCSI port of pmic-glink switches the role; without it (no
	 * ADSP) the controller stays in its default, peripheral, role.
	 * SuperSpeed over the QMP combo PHY, which takes the plug
	 * orientation from the Type-C port, as stock runs it.
	 */
	maximum-speed = "super-speed";

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l2d_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;
	vdda12-supply = <&vreg_l3g_1p2>;

	phys = <&pmih0108_eusb2_repeater>;

	status = "okay";
};
