# SPDX-License-Identifier: GPL-2.0
# Samsung Galaxy Tab S7 FE 5G. The boot image's initramfs mounts the root filesystem from the microSD card.
CONFIG_BUILTIN_DTB_NAME="qcom/sm7225-samsung-gts7xllite"
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
# Touch bring-up: SPI controller built in, spidev for the userspace probe, uinput for the touch daemon.
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_SPIDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_GPIO_CDEV=y
# Early console: simpledrm drives the bootloader framebuffer (instead of simplefb) until msm's DSI below takes over.
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_SIMPLE is not set

# The initramfs can also run a squashfs root through a loop device under a tmpfs overlay: overlayfs built in.
CONFIG_OVERLAY_FS=y
# systemd mounts binfmt_misc and sets up additional binary formats at boot.
CONFIG_BINFMT_MISC=y
# Display: msm DSI with the TS124QDM panel. The display clock controller must be built in for the same reason as the
# GPU's below (MDSS sits in its GDSC); the panel driver too, since the init loads no modules.
CONFIG_SM_DISPCC_6350=y
# The DSI controller's refgen supply (the SoC's internal reference block, no voltage setting); as a module dsi0 never probes.
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_DRM_PANEL_BOE_TS124QDM=y
# The panel's 5 V backlight boost (MAX77816 on i2c@988000, enable gpio72).
CONFIG_REGULATOR_MAX77816=y
# Battery percentage, charging status, the wall-charger rate and the temperature cut-off. The PMIC ADC that reads
# the battery thermistor is built in with it: as a module the gauge would wait for the root filesystem.
CONFIG_BATTERY_SM5714=y
CONFIG_QCOM_SPMI_ADC5=y
# GPU clock controller must be built in: the init cannot load modules, and without it the GPU IOMMU waits forever (arm-smmu -110).
CONFIG_SM_GPUCC_6350=y

# Phonewave's zram-swap (compressed swap in RAM, every device): built in, as the rootfs carries no modules.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
# Book Cover Keyboard on the pogo connector (STM32 MCU on i2c10, power from pm6350_l6 while attached). A module during
# bring-up: reloaded over SSH without a flash.
CONFIG_KEYBOARD_SAMSUNG_POGO=m
# S Pen: Wacom W9021 on i2c8 (0x56), power from pm6350_l8. A module during bring-up.
CONFIG_TOUCHSCREEN_WACOM_W9021=m
