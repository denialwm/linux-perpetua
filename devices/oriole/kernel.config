# SPDX-License-Identifier: GPL-2.0
#
# Google Pixel 6
CONFIG_BUILTIN_DTB_NAME="exynos/google/gs101-oriole"
# The RAM-based rescue charges the battery without loading modules: the
# MAX77759 charger turns its buck on from TCPM's source power supply.
CONFIG_MFD_MAX77759=y
CONFIG_CHARGER_MAX77759=y
CONFIG_BATTERY_MAX17042=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MAXIM=y
# The panel. Its framebuffers are contiguous (no IOMMU yet): one
# 1080x2400 XRGB8888 buffer is 10.4 MB.
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC3=y
CONFIG_CMA_SIZE_MBYTES=128
# The touchscreen, an STM FTS5 on SPI11.
CONFIG_TOUCHSCREEN_STMFTS=y
# The vibration motor's CS40L25A haptics driver; its firmware is in the
# boot tail.
CONFIG_INPUT_CS40L25=m
# Trusty, the secure OS the bootloader starts: its IPC channel serves the
# trusted apps, such as the fingerprint sensor's, Keymaster and Gatekeeper.
# Modules: only userspace uses it.
CONFIG_TRUSTY=m
CONFIG_TRUSTY_IRQ=y
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
# The fingerprint sensor's reset, interrupt, supply and SPI clocks; Trusty
# drives the sensor itself.
CONFIG_TEE_FP=y
