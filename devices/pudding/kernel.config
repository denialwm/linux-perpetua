# SPDX-License-Identifier: GPL-2.0
#
# Xiaomi 17 (pudding)
CONFIG_BUILTIN_DTB_NAME="qcom/kaanapali-xiaomi-pudding"

# The RedMagic 11 Pro, on the same SoC, kept resetting until the watchdog
# driver was built in, and the boot userspace loads no modules.
CONFIG_QCOM_WDT=y

# Reboot into fastboot from Linux (reboot-to bootloader): the way back to
# Android on slot a without the keys.
CONFIG_NVMEM_REBOOT_MODE=y

# The panel. Until msm takes the display over, simpledrm shows the
# bootloader's splash framebuffer, in place of simplefb.
CONFIG_DRM_PANEL_XIAOMI_PUDDING_P3=y
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_SIMPLE is not set

# Touchscreen (Synaptics TouchComm on SPI19).
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=m

# Haptics: the PMIH0108's HAP530 drives the LRA.
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# Speakers: two Cirrus CS35L43 amplifiers on I2C13 and the primary MI2S.
CONFIG_SND_SOC_CS35L43_I2C=m

# Pass `iw reg set` on to the Wi-Fi firmware: Xiaomi's board data starts it
# in China's rules, and the phone sets its own country. The cfg80211 option
# behind it needs EXPERT, which changes the defaults below; they stay as the
# shared configuration has them.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEBUG_MEMORY_INIT=y
CONFIG_RFKILL_INPUT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
