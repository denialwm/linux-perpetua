# SPDX-License-Identifier: GPL-2.0
#
# OnePlus Pad 3
CONFIG_BUILTIN_DTB_NAME="qcom/sm8750-oneplus-erhai"

CONFIG_DRM_PANEL_ONEPLUS_ICELAND_NT36536=y
CONFIG_BACKLIGHT_KTZ8869_ICELAND=y
CONFIG_TOUCHSCREEN_NT36536_SPI=m

# Speaker amplifiers (6x AW88261 on I2C hub 4 and 9)
CONFIG_SND_SOC_AW88261=m

# Stylus charger: CPS8601 transmitter on I2C hub 3, coil boost over PMIC GLINK
CONFIG_REGULATOR_ONEPLUS_GLINK_HBOOST=m
CONFIG_CHARGER_CPS8601=m

# Pogo-pin keyboard cover on the QUP2 SE0 UART
CONFIG_KEYBOARD_ONEPLUS_POGO=m

# SuperVOOC 80 W: SC8547A charge pump and the VOOC PHY driver
CONFIG_CHARGER_SC8547=m
CONFIG_CHARGER_SC8547_SVOOC=m
# PMK8550 VADC gen3: the VOOC pump NTC channels (0x74b-0x74d)
CONFIG_QCOM_SPMI_ADC5_GEN3=m

# Battery current limiting monitor of the PMIH0108 and PM8550 (BCL)
CONFIG_SENSORS_QCOM_SPMI_BCL=m

# The battery thermistor zone hands its trips to user space, as stock does
CONFIG_THERMAL_GOV_USER_SPACE=y

# Cameras: SmartSens C658 (rear, CCI0) and D154 (front, QUP SE9) into
# CAMSS through the CSI2 PHYs
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_SMARTSENS_CS=m
# Rear camera autofocus (GT9772), calibration EEPROM and the PMIC flash
# LEDs as its V4L2 flash
CONFIG_VIDEO_DW9719=m
CONFIG_EEPROM_AT24=m
CONFIG_V4L2_FLASH_LED_CLASS=m

# Gunyah hypervisor watchdog: systemd pets it (RuntimeWatchdogSec), so a
# hung system resets instead of staying frozen
CONFIG_GUNYAH_WATCHDOG=m

# Camera buffers: libcamera's software ISP allocates its output frames
# from the CMA heap (/dev/dma_heap/reserved); 32 MiB holds no full-size
# frame (4152x3120 ABGR is 50 MiB). 256 MiB holds four, as on aston.
CONFIG_CMA_SIZE_MBYTES=256
