# SPDX-License-Identifier: GPL-2.0
# Xiaomi Redmi Note 7 with a Tianma NT36672A panel.
CONFIG_BUILTIN_DTB_NAME="qcom/sdm660-xiaomi-lavender"
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=y
CONFIG_INPUT_EVDEV=y
CONFIG_EXTCON_USB_GPIO=y
# The RAM-based rescue initramfs needs these without loading modules.
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
