#
# OnePlus Pad 4
CONFIG_BUILTIN_DTB_NAME="qcom/kaanapali-oneplus-iceland"

CONFIG_DRM_PANEL_ONEPLUS_ICELAND_NT36536=y
CONFIG_BACKLIGHT_KTZ8869_ICELAND=y
CONFIG_TOUCHSCREEN_NT36536_SPI=m
CONFIG_SND_SOC_TFA9865=m
CONFIG_TYPEC_MUX_WCD939X_USBSS=y
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_CHARGER_SC8547=m
CONFIG_CHARGER_SC8547_SVOOC=m
# The case temperature the tablet throttles on: thermistors weighted.
CONFIG_THERMAL_WEIGHTED_SENSOR=m
# Rear and front cameras: SmartSens sensors on CSIPHY4 and CSIPHY5.
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_SMARTSENS_CS=m

# Two freezes during SuperVOOC charging left no message: the screen and the
# network stopped together. The buddy detector names a CPU whose timer
# stops; CSD lock wait debugging names a stuck IPI's target and function.
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_CSD_LOCK_WAIT_DEBUG=y
CONFIG_CSD_LOCK_WAIT_DEBUG_DEFAULT=y

# Suspend: pm_debug_messages and pm_wakeup_irq name what ends a sleep.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_REGULATOR_ONEPLUS_GLINK_HBOOST=m
