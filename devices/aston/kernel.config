# SPDX-License-Identifier: GPL-2.0
#
# OnePlus Ace 3 / OnePlus 12R
CONFIG_BUILTIN_DTB_NAME="qcom/sm8550-oneplus-aston"

# The panel stays dark when fbdev powers it up at boot, while the display
# still runs from the bootloader's splash; it lights when Denial does the
# first power-up, as on the reference kernel, which had no fbdev.
# CONFIG_DRM_FBDEV_EMULATION is not set

CONFIG_DRM_PANEL_ONEPLUS_ASTON_AA551=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=m
CONFIG_BMI270_SPI=m
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_SENSORS_IIO_HWMON=m
CONFIG_CHARGER_SC8517=m
CONFIG_SPI_GPIO=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# Native UFF fingerprint power/reset/IRQ; sensor transactions stay in QTEE.
CONFIG_OPLUS_UFF_FP=m

# NXP TFA9873 speaker amplifiers (top and bottom) on Secondary MI2S.
CONFIG_SND_SOC_TFA987X=m

# Ultrawide camera (Sony IMX355 on CSIPHY3).
CONFIG_VIDEO_IMX355=m

# Camera buffers: the software ISP allocates its frames from the CMA heap;
# 32 MiB fits only four 820x616 frames.
CONFIG_CMA_SIZE_MBYTES=256

# Front camera (Samsung S5K3P9 on CSIPHY1).
CONFIG_VIDEO_S5K3P9=m

# Main camera (Sony IMX890 on CSIPHY2, 3-trio C-PHY).
CONFIG_VIDEO_IMX890=m

# Main camera focus motor (JD5516W, DW9719 register layout).
CONFIG_VIDEO_DW9719=m
