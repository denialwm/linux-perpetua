#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Checks that a device is registered completely and consistently.

Usage: devices/check DEVICE OBJDIR [BASE]

OBJDIR is the device's object directory, configured with devices/config and
built (at least the dtbs; the Image too for the built-in tree check). With
BASE, also checks the code that the commits BASE..HEAD add for the patterns
that devices/README rules out. Run it from the top of the source tree.
Prints every check and exits 1 when any fails.
"""
from pathlib import Path
import re
import shutil
import subprocess
import sys

failures = 0


def check(ok, what, why=''):
    global failures
    print(('ok    ' if ok else 'FAIL  ') + what + ('' if ok or not why else f': {why}'))
    failures += not ok
    return ok


def registry(device):
    """The variables of devices/DEVICE/device, as the shell sees them."""
    out = subprocess.run(['sh', '-c', '. "$1"; printf "%s\\n" "$name" "$vendor" "$soc" "$boot"',
                          'sh', f'./devices/{device}/device'],
                         capture_output=True, text=True, check=True).stdout.split('\n')
    return dict(zip(['name', 'vendor', 'soc', 'boot'], out))


def fragment(path):
    """KEY -> value of a configuration fragment or .config; 'n' when unset."""
    values = {}
    for line in Path(path).read_text().splitlines():
        if m := re.fullmatch(r'(CONFIG_\w+)=(.*)', line):
            values[m[1]] = m[2]
        elif m := re.fullmatch(r'# (CONFIG_\w+) is not set', line):
            values[m[1]] = 'n'
    return values


def parse_dts(text):
    """The decompiled tree as nested dicts; properties are kept as text."""
    root, stack = {}, []
    node = root
    for line in text.splitlines():
        line = line.strip()
        if m := re.fullmatch(r'(\S+) \{', line):
            child = node.setdefault('/nodes', {}).setdefault(m[1], {})
            stack.append(node)
            node = child
        elif line == '};':
            node = stack.pop()
        elif m := re.fullmatch(r'([^=\s]+)(?: = (.*))?;', line):
            node[m[1]] = m[2] or ''
    return root['/nodes']['/']


def strings(value):
    return set(re.findall(r'"((?:[^"\\]|\\.)*)"', value or ''))


def child(node, *path):
    for name in path:
        node = node.get('/nodes', {}).get(name)
        if node is None:
            return None
    return node


def phandles(node, found):
    if 'phandle' in node:
        found.add(int(node['phandle'].strip('<>'), 0))
    for sub in node.get('/nodes', {}).values():
        phandles(sub, found)
    return found


def decompile(dtb, objdir):
    dtc = objdir / 'scripts/dtc/dtc'
    dtc = str(dtc) if dtc.exists() else shutil.which('dtc')
    if not dtc:
        sys.exit('devices/check: no dtc in OBJDIR/scripts/dtc or on PATH')
    return parse_dts(subprocess.run([dtc, '-q', '-I', 'dtb', '-O', 'dts', dtb], check=True,
                                    capture_output=True, text=True).stdout)


def identity(tree):
    handoff = child(tree, 'chosen', 'fdt-handoff') or {}
    return {key: strings(handoff.get('stock-' + key))
            for key in ['compatible', 'model', 'bootargs']}


def disjoint(a, b):
    """Whether no bootloader tree can match both handoff descriptions."""
    if a['compatible'] and b['compatible'] and not a['compatible'] & b['compatible']:
        return True
    if a['model'] and b['model'] and not a['model'] & b['model']:
        return True

    def conflict(x, y):
        # A boot argument holds one value at a time.
        kx, _, vx = x.partition('=')
        ky, _, vy = y.partition('=')
        return '=' in x and '=' in y and kx == ky and vx != vy
    return bool(a['bootargs'] and b['bootargs'] and
                all(conflict(x, y) for x in a['bootargs'] for y in b['bootargs']))


def hygiene(base):
    """Patterns that added code must not contain (devices/README). devices/
    holds host tools, such as the handoff test that builds the kernel's own
    handoff code, not kernel code."""
    diff = subprocess.run(['git', 'diff', '--no-color', '-U0', f'{base}..HEAD', '--',
                           '*.c', '*.h', ':(exclude)devices/'],
                          capture_output=True, text=True, check=True).stdout
    rules = [(r'\bof_machine_is_compatible\s*\(',
              'board checks in drivers; describe the hardware in the device tree'),
             (r'#\s*include\s*"[^"]*\.(c|inc)"', 'textually included code; build a separate object'),
             (r'\bmodule_param(_named|_array|_cb)?\s*\(',
              'module parameters that enable hardware; describe it in the device tree')]
    found = {why: [] for _, why in rules}
    path = None
    for line in diff.splitlines():
        if line.startswith('+++ '):
            path = line[6:]
        elif line.startswith('+'):
            for pattern, why in rules:
                if re.search(pattern, line):
                    found[why].append(f'{path}: {line[1:].strip()}')
    for why, hits in found.items():
        check(not hits, f'no added {why.split(";")[0]}',
              f'{why}\n        ' + '\n        '.join(hits[:10]))
    names = subprocess.run(['git', 'diff', '--name-only', '--diff-filter=A', f'{base}..HEAD'],
                           capture_output=True, text=True, check=True).stdout.split()
    included = [n for n in names if n.endswith('.inc')]
    check(not included, 'no added .inc files', ' '.join(included))


def main():
    if len(sys.argv) not in (3, 4):
        sys.exit(__doc__)
    device, objdir = sys.argv[1], Path(sys.argv[2])
    base = sys.argv[3] if len(sys.argv) == 4 else None
    if not check(re.fullmatch(r'[a-z0-9][a-z0-9-]*', device) and
                 Path(f'devices/{device}/device').is_file(),
                 f'devices/{device}/device', 'missing, or not a lower-case codename'):
        return 1

    entry = registry(device)
    for key in ['name', 'vendor', 'soc', 'boot']:
        check(entry[key], f'device: {key}', 'not set')
    for name in [f'arch/arm64/configs/{entry["vendor"]}.config',
                 f'arch/arm64/configs/{entry["soc"]}.config', f'devices/{device}/kernel.config']:
        check(Path(name).is_file(), name, 'missing')
    adapter = Path(f'devices/boot/{entry["boot"]}')
    check(adapter.is_file() and adapter.stat().st_mode & 0o111, f'boot chain {adapter}',
          'missing or not executable')

    own = fragment(f'devices/{device}/kernel.config')
    dtb_name = own.get('CONFIG_BUILTIN_DTB_NAME', '').strip('"')
    if not check(dtb_name, 'kernel.config sets CONFIG_BUILTIN_DTB_NAME', 'not set'):
        return 1
    dts = Path(f'arch/arm64/boot/dts/{dtb_name}.dts')
    check(dts.is_file(), str(dts), 'missing')
    makefile = dts.parent / 'Makefile'
    check(makefile.is_file() and re.search(rf'\b{re.escape(dts.stem)}\.dtb\b',
                                           makefile.read_text()),
          f'{makefile} builds {dts.stem}.dtb', 'not listed')

    if not check((objdir / '.config').is_file(), f'{objdir}/.config', 'run devices/config first'):
        return 1
    have = fragment(objdir / '.config')
    with_layers = subprocess.run(['sh', 'devices/config', '--fragments', device], check=True,
                                 capture_output=True, text=True).stdout.split()[1:]
    want = {}
    for name in with_layers:
        want.update(fragment(name))
    lost = [f'{k}={v} (is {have.get(k, "n")})' for k, v in sorted(want.items())
            if have.get(k, 'n') != v]
    check(not lost, 'OBJDIR/.config holds every fragment value', ', '.join(lost[:10]))

    dtb = objdir / f'arch/arm64/boot/dts/{dtb_name}.dtb'
    if not check(dtb.is_file(), str(dtb), 'build the dtbs first'):
        return 1
    tree = decompile(dtb, objdir)
    compatible = re.findall(r'"([^"]+)"', tree.get('compatible', ''))
    if check(compatible, 'root compatible'):
        bindings = subprocess.run(['grep', '-rlwF', '--include=*.yaml', compatible[0],
                                   'Documentation/devicetree/bindings'],
                                  capture_output=True, text=True).stdout.split()
        check(bindings, f'"{compatible[0]}" is documented', 'add it to its dt-bindings')
    chosen = child(tree, 'chosen') or {}
    check('bootargs' in chosen, '/chosen/bootargs', 'give the boot arguments in the tree')
    handoff = child(tree, 'chosen', 'fdt-handoff')
    if check(handoff is not None, '/chosen/fdt-handoff',
             'describe the bootloader tree it replaces (fdt-handoff.yaml)'):
        mine = identity(tree)
        check(mine['compatible'], 'fdt-handoff: stock-compatible', 'required')
        check(mine['model'] or mine['bootargs'], 'fdt-handoff: stock-model or stock-bootargs',
              'a root compatible names a SoC that many devices share; name the device too')
        known = phandles(tree, set())
        for name, node in handoff.get('/nodes', {}).items():
            missing = [p for p in ['stock-path', 'stock-property', 'stock-key', 'target',
                                   'target-property'] if p not in node]
            target = node.get('target', '').strip('<>')
            check(name.endswith('-address') and not missing and target and
                  int(target, 0) in known, f'fdt-handoff: {name}',
                  f'missing {" ".join(missing)}' if missing else 'bad name or target')
        for other in sorted(Path('devices').glob('*/kernel.config')):
            codename = other.parent.name
            if codename == device:
                continue
            name = fragment(other).get('CONFIG_BUILTIN_DTB_NAME', '').strip('"')
            path = objdir / f'arch/arm64/boot/dts/{name}.dtb'
            if not path.is_file():
                print(f'skip  identity against {codename}: {name}.dtb not in this object tree')
                continue
            check(disjoint(mine, identity(decompile(path, objdir))),
                  f'identity differs from {codename}',
                  'both descriptions can match one bootloader tree')

    image = objdir / 'arch/arm64/boot/Image'
    if image.is_file():
        check(dtb.read_bytes() in image.read_bytes(), 'Image carries this device tree',
              'rebuild the Image after the dtb')
    else:
        print('skip  built-in tree: no Image yet')

    if base:
        hygiene(base)
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
