# SPDX-License-Identifier: GPL-2.0
# Lenovo Idea Tab Pro (TB373FU).
CONFIG_BUILTIN_DTB_NAME="mediatek/mt6897-lenovo-tb373fu"
# The boot console on the bootloader's splash buffer, readable at 2944x1840.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# The USB network and serial gadget, without loading modules.
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
# The battery gauge.
CONFIG_FUEL_GAUGE_MM8013=m
# The backlight: two SGM37604A chips behind one backlight device.
CONFIG_LEDS_SGM37604A=m
CONFIG_BACKLIGHT_LED=m
# The panel and its bias supplies.
CONFIG_DRM_PANEL_NOVATEK_NT36532=m
CONFIG_REGULATOR_TPS65132=m
