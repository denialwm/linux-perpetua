# SPDX-License-Identifier: GPL-2.0
#
# Nubia RedMagic 11 Pro (NX809J)
CONFIG_BUILTIN_DTB_NAME="qcom/kaanapali-nubia-nx809j"

CONFIG_DRM_PANEL_RAYDIUM_RM692H5=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=m
CONFIG_TYPEC_MUX_WCD939X_USBSS=y
CONFIG_SND_SOC_AW88461=m
CONFIG_SENSORS_AWP1921=m
CONFIG_SENSORS_PWM_FAN=m

# An earlier port of this phone kept resetting until the watchdog driver
# was built in, and the boot userspace loads no modules.
CONFIG_QCOM_WDT=y

CONFIG_GOODIX_TEE_FP=y

# Ultrawide camera (OmniVision OV50D40 on CSIPHY1, standalone CSI2 PHY).
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_OV50D40=m
# Front (OmniVision OV16A1Q, CSIPHY3) and auxiliary (OV02F10, CSIPHY0) cameras.
CONFIG_VIDEO_OV02F10=m
CONFIG_VIDEO_OV16A1Q=m
