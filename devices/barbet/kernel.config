# SPDX-License-Identifier: GPL-2.0
#
# Google Pixel 5a
CONFIG_BUILTIN_DTB_NAME="qcom/sm7250-google-barbet"

# Display, GPU and touch
CONFIG_SM_DISPCC_7250=y
CONFIG_SM_GPUCC_7250=y
CONFIG_DRM_PANEL_SAMSUNG_SOFEF00=y
CONFIG_TOUCHSCREEN_STFTS_SPI=y

# Haptics, thermal, RTC and battery
CONFIG_INPUT_DRV2624=y
CONFIG_BATTERY_BARBET=y
CONFIG_CHARGER_QCOM_PM7250B=y
CONFIG_QCOM_SPMI_ADC5=y

# PM8150L camera flash / torch
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH=y

# Thermal zones from the SoC TSENS blocks
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_QCOM_TSENS=y

# PM8150 RTC and alarm
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y

# Audio: ADSP, codecs and the barbet speaker/microphone paths
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
# The USB offload helper is not used and would cap the machine driver at m
# CONFIG_SND_SOC_QDSP6_USB is not set
CONFIG_SND_SOC_SM8250=y
CONFIG_SOUNDWIRE=y
CONFIG_REMOTEPROC=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_RT5514=y
CONFIG_SND_SOC_RT5514_SPI=y
CONFIG_SND_SOC_TFA9874=y
CONFIG_SND_SOC_TAS2562=y

# Wi-Fi through the modem
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QRTR=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y

# The framebuffer console, so the panel shows the boot
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# pacman 7 uses a Landlock sandbox for downloads
CONFIG_SECURITY_LANDLOCK=y
