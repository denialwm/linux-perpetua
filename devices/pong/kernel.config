#
# Nothing Phone (2)
CONFIG_BUILTIN_DTB_NAME="qcom/sm8475-nothing-pong"

# The boot userspace has no modules: what it needs before the root
# filesystem is mounted is built in.
CONFIG_OVERLAY_FS=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y

# The panel, built in: the boot userspace draws before any module loads.
CONFIG_DRM_PANEL_VISIONOX_NT37705=y

# Bring-up reads the console off the 1080x2412 screen: a font a photo keeps.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# CONFIG_FONT_8x16 is not set
