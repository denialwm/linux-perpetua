#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Writes a boot image for the GKI boot chain of devices launched with
Android 12, which have no init_boot partition.

The bootloader loads the vendor_boot ramdisks and then the ramdisk of the
boot image, so the boot image carries both the kernel and the boot
userspace. The device's own stock boot image is the template: its version 4
header, partition size, AVB salt and properties are kept, and the kernel and
the ramdisk replace its payload. The template must carry a legacy LZ4 kernel
and no ramdisk, as the stock images of these devices do, and no boot
signature; the kernel is compressed the same way.
The image gets an unsigned AVB hash footer, as android-gki writes; an
unlocked bootloader accepts it.
Needs lz4, avbtool and unpack_bootimg.

Usage: devices/boot/android12-gki TEMPLATE IMAGE RAMDISK OUTPUT [EVIDENCE]

EVIDENCE, when given, is a directory that receives the avbtool
verification, the unpacked header and the unpacked image.
"""
import hashlib
import json
from pathlib import Path
import re
import struct
import subprocess
import sys
import tempfile

PAGE = 4096
# Version 4 header offsets: the kernel and ramdisk sizes, the header
# version and the boot signature size.
KERNEL_SIZE, RAMDISK_SIZE, HEADER_VERSION, SIGNATURE_SIZE = 8, 12, 40, 1580
LEGACY_LZ4 = b'\x02\x21\x4c\x18'


def run(*args):
    return subprocess.run(list(map(str, args)), check=True, capture_output=True).stdout


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def padded(data):
    return data + b'\0' * (-len(data) % PAGE)


def main():
    if len(sys.argv) not in (5, 6):
        sys.exit(__doc__)
    template, image, ramdisk, output = map(Path, sys.argv[1:5])
    evidence = Path(sys.argv[5]) if len(sys.argv) == 6 else None
    stock = template.read_bytes()
    ramdisk_data = ramdisk.read_bytes()
    assert image.stat().st_size and ramdisk_data, 'empty kernel or ramdisk'
    assert stock[PAGE:PAGE + 4] == LEGACY_LZ4, 'template kernel is not legacy LZ4'
    with tempfile.TemporaryDirectory() as scratch:
        packed = Path(scratch) / 'Image.lz4'
        run('lz4', '-q', '-l', '-12', image, packed)
        kernel_data = packed.read_bytes()
    assert kernel_data[:4] == LEGACY_LZ4, 'lz4 did not write legacy LZ4'

    header = bytearray(stock[:PAGE])
    assert header[:8] == b'ANDROID!', 'template is not an Android boot image'
    assert struct.unpack_from('<I', header, HEADER_VERSION)[0] == 4, 'template header is not version 4'
    assert struct.unpack_from('<I', header, SIGNATURE_SIZE)[0] == 0, 'template has a boot signature'
    assert struct.unpack_from('<I', header, KERNEL_SIZE)[0], 'template carries no kernel'
    assert struct.unpack_from('<I', header, RAMDISK_SIZE)[0] == 0, 'template carries a ramdisk'
    struct.pack_into('<I', header, KERNEL_SIZE, len(kernel_data))
    struct.pack_into('<I', header, RAMDISK_SIZE, len(ramdisk_data))

    info = run('avbtool', 'info_image', '--image', template).decode()
    algorithm = re.search(r'^Algorithm:\s+(\S+)$', info, re.M).group(1)
    salt = re.search(r'^\s*Salt:\s*([0-9a-f]+)\s*$', info, re.M).group(1)
    props = re.findall(r"^\s*Prop: (\S+) -> '(.*)'$", info, re.M)

    output.write_bytes(bytes(header) + padded(kernel_data) + padded(ramdisk_data))
    run('avbtool', 'add_hash_footer', '--image', output, '--partition_size', len(stock),
        '--partition_name', 'boot', '--hash_algorithm', 'sha256', '--algorithm', 'NONE',
        '--salt', salt, *[a for key, value in props for a in ('--prop', f'{key}:{value}')])
    image = output.read_bytes()
    assert len(image) == len(stock) and image[:PAGE] == header

    with tempfile.TemporaryDirectory() as scratch:
        # avbtool checks the hash descriptor against boot.img next to the
        # image it verifies, whatever OUTPUT is called.
        named = Path(scratch) / 'boot.img'
        named.symlink_to(output.resolve())
        verification = run('avbtool', 'verify_image', '--image', named)
        unpacked = Path(evidence or scratch) / 'boot-unpacked'
        described = run('unpack_bootimg', '--boot_img', output, '--out', unpacked)
        assert (unpacked / 'kernel').read_bytes() == kernel_data, 'unpacked kernel differs'
        assert (unpacked / 'ramdisk').read_bytes() == ramdisk_data, 'unpacked ramdisk differs'
    if evidence:
        (evidence / 'boot-verification.txt').write_bytes(verification)
        (evidence / 'boot-header.txt').write_bytes(described)
    print(json.dumps({'bytes': len(image), 'sha256': sha256(image),
                      'template_sha256': sha256(stock), 'template_algorithm': algorithm}))


if __name__ == '__main__':
    main()
