#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Pack an Android v2 boot image: raw arm64 kernel and ramdisk, with the template's DTB.

Usage: android-v2 TEMPLATE IMAGE RAMDISK OUTPUT [EVIDENCE]
Samsung layout, as on the Galaxy Tab S7 FE: header v2, 4096-byte pages, no vendor_boot,
no second payload, no recovery DTBO, one DTB in the boot image, a short signer trailer after
the DTB, then an AVB vbmeta blob and footer at the end of the partition.
Keeps the template's header, DTB, signer trailer, vbmeta blob and footer; replaces the kernel and
the ramdisk; moves the vbmeta blob and rewrites the footer. The kept vbmeta hash no longer matches
the image: a bootloader that enforces it (locked) refuses the image. An unlocked one boots it, as it
boots a Magisk-patched image of the same layout.
IMAGE must carry the Perpetua built-in DTB. No device access. OUTPUT must not exist.
"""
import hashlib
import json
from pathlib import Path
import struct
import subprocess
import sys
import tempfile

PAGE = 4096
FOOTER = ">4sIIQQQ28x"  # AVBf, major, minor, original size, vbmeta offset, vbmeta size


def run(*args):
    return subprocess.check_output(list(map(str, args)))


def sha(data):
    return hashlib.sha256(data).hexdigest()


def up(n):
    return -(-n // PAGE) * PAGE


def parse(img):
    assert img[:8] == b"ANDROID!", "not an Android boot image"
    assert struct.unpack_from("<I", img, 40)[0] == 2, "requires header v2"
    assert struct.unpack_from("<I", img, 36)[0] == PAGE, "requires 4096-byte pages"
    ks, rs, ss = (struct.unpack_from("<I", img, o)[0] for o in (8, 16, 24))
    rd, ds = (struct.unpack_from("<I", img, o)[0] for o in (1632, 1648))
    assert ss == 0 and rd == 0, "second payload and recovery DTBO unsupported"
    magic, _, _, orig, voff, vsize = struct.unpack(FOOTER, img[-64:])
    assert magic == b"AVBf", "no AVB footer"
    k0 = PAGE
    r0 = k0 + up(ks)
    d0 = r0 + up(rs)
    end = d0 + up(ds)
    assert end <= orig <= voff and voff % PAGE == 0, "unexpected layout after the DTB"
    return dict(ks=ks, rs=rs, ds=ds, k0=k0, r0=r0, d0=d0, end=end, orig=orig,
                voff=voff, vsize=vsize)


def main():
    if len(sys.argv) not in (5, 6):
        sys.exit(__doc__)
    template, source, ramdisk, output = map(Path, sys.argv[1:5])
    evidence = Path(sys.argv[5]) if len(sys.argv) == 6 else None
    assert not output.exists(), "refusing to replace an existing image"
    stock = template.read_bytes()
    t = parse(stock)
    image = source.read_bytes()
    assert image[56:60] == b"ARM\x64", "not a raw ARM64 Image"
    initrd = ramdisk.read_bytes()
    assert initrd, "empty ramdisk"
    dtb = stock[t["d0"]:t["d0"] + t["ds"]]
    trailer = stock[t["end"]:t["orig"]]
    vbmeta = stock[t["voff"]:t["voff"] + t["vsize"]]

    header = bytearray(stock[:PAGE])
    struct.pack_into("<I", header, 8, len(image))
    struct.pack_into("<I", header, 16, len(initrd))
    ident = hashlib.sha1()
    for data in (image, initrd, b"", b"", dtb):  # kernel, ramdisk, second, recovery DTBO, DTB
        ident.update(data)
        ident.update(struct.pack("<I", len(data)))
    header[576:608] = ident.digest() + bytes(12)

    body = bytes(header)
    for data in (image, initrd, dtb):
        body += data + bytes(-len(data) % PAGE)
    body += trailer
    orig = len(body)
    body += bytes(-orig % PAGE)
    voff = len(body)
    packed = body + vbmeta
    assert len(packed) + 64 <= len(stock), "image exceeds boot partition"
    packed += bytes(len(stock) - 64 - len(packed))
    packed += struct.pack(FOOTER, b"AVBf", *struct.unpack(FOOTER, stock[-64:])[1:3], orig, voff, len(vbmeta))
    assert len(packed) == len(stock)
    output.write_bytes(packed)

    with tempfile.TemporaryDirectory(prefix="v2-boot-") as tmp:
        unpacked = Path(tmp) / "u"
        described = run("unpack_bootimg", "--boot_img", output, "--out", unpacked)
        assert (unpacked / "kernel").read_bytes() == image
        assert (unpacked / "ramdisk").read_bytes() == initrd
        assert (unpacked / "dtb").read_bytes() == dtb
        info = run("avbtool", "info_image", "--image", output).decode()
    got = output.read_bytes()
    assert got[-64:-52] == stock[-64:-52] and got[voff:voff + len(vbmeta)] == vbmeta
    # Apart from the two sizes and the ID, every header byte is the template's.
    restored = bytearray(header)
    for start, end in ((8, 12), (16, 20), (576, 608)):
        restored[start:end] = stock[start:end]
    assert restored == stock[:PAGE]
    record = dict(bytes=len(got), sha256=sha(got), template_sha256=sha(stock),
                  image_sha256=sha(image), ramdisk_sha256=sha(initrd), dtb_sha256=sha(dtb),
                  original_image_size=orig, vbmeta_offset=voff, header_version=2, page_size=PAGE)
    if evidence:
        evidence.mkdir(parents=True, exist_ok=True)
        (evidence / "boot-header.txt").write_bytes(described)
        (evidence / "boot-avb.txt").write_text(info)
        (evidence / "boot-format.json").write_text(json.dumps(record, indent=2) + "\n")
    print(json.dumps(record))


if __name__ == "__main__":
    main()
