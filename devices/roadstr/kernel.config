#
# Motorola Edge 70
CONFIG_BUILTIN_DTB_NAME="qcom/eliza-motorola-roadstr"

CONFIG_DRM_PANEL_NOVATEK_NT37706=y
CONFIG_INPUT_AW86927=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y

# The boot userspace has no modules: what it needs before the root
# filesystem is mounted is built in.
CONFIG_CLK_ELIZA_DISPCC=y
CONFIG_CLK_ELIZA_GPUCC=y
CONFIG_CLK_ELIZA_TCSRCC=y
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_OVERLAY_FS=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y
