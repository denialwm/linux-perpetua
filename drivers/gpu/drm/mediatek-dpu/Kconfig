config DRM_MEDIATEK_DPU
	tristate "MediaTek Dimensity display processor"
	depends on DRM && OF
	depends on ARCH_MEDIATEK || COMPILE_TEST
	select DRM_CLIENT_SELECTION
	select DRM_KMS_HELPER
	select DRM_GEM_DMA_HELPER
	select DRM_MIPI_DSI
	select DRM_PANEL
	help
	  Choose this option for the display pipeline of MediaTek Dimensity
	  SoCs that split it into overlay (OVL) and display subsystems,
	  such as the MT6897.

	  If M is selected the module will be called mediatek-dpu.
